# =============================================================================
# Open WebUI stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# Container timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Used for log timestamps and any UI-rendered date/time references.
TIMEZONE=Etc/UTC

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Host port published for the web UI (container listens on 8080). Published on
# all interfaces so it's reachable on your LAN out of the box. Prefer it behind
# a reverse proxy / loopback only? Prefix the mapping in compose.yaml with
# 127.0.0.1:.
# NOTE: 8080 is a common host port (also the default for filebrowser and
# calibre in this repo) — change if it clashes on your host.
OPENWEBUI_PORT=8080

# -----------------------------------------------------------------------------
# Service config
# -----------------------------------------------------------------------------

# Ollama API endpoint — Open WebUI calls this for chat completions, model
# listing, embeddings, and pulls. Point it at your Ollama host (an LLM
# workstation, another machine, or the same host).
#
# The container sits on proxy_net (bridge) and routes outbound through the
# host. If your Ollama host is on a tailnet, using its Tailscale IP avoids any
# dependency on MagicDNS resolution from inside the container.
#
#   By IP:       http://100.x.y.z:11434   (or a LAN IP, e.g. http://192.168.x.x:11434)
#   MagicDNS:    http://<hostname>:11434
#   Same host:   http://host.docker.internal:11434  (extra_hosts is set in compose)
OLLAMA_BASE_URL=http://100.x.y.z:11434

# CORS allowlist. Defaults to * (and logs a loud boot warning). Restrict to your
# public URL to silence the warning and tighten access, e.g.
# https://openwebui.example.com.
CORS_ALLOW_ORIGIN=*

# Account registration toggle. Boot once with `true` to create the first admin
# account, then set `false` and recreate the container (Open WebUI reads this
# only at startup — an .env edit alone won't apply it).
ENABLE_SIGNUP=true

# User-Agent for Open WebUI's outbound web fetches (RAG, tools). Cosmetic;
# silences a boot warning.
USER_AGENT=open-webui/homelab

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------

# Session signing key. Open WebUI auto-generates and persists this in the data
# volume if unset, but pinning it here makes sessions survive a data wipe and
# keeps the value out of the container filesystem.
# Generate with: openssl rand -base64 32
WEBUI_SECRET_KEY=

# HuggingFace Hub read-only token. OPTIONAL — only needed if you swap
# embedding/reranker models often enough to hit anonymous download rate limits.
# Create at https://huggingface.co/settings/tokens
HF_TOKEN=

# -----------------------------------------------------------------------------
# Volume paths
# -----------------------------------------------------------------------------

# Persistent app data — SQLite DB, uploaded files, RAG vector store, user
# accounts, model/tools cache, and the auto-generated session signing key
# (unless WEBUI_SECRET_KEY is pinned above). Back this up; losing it loses all
# chat history, user accounts, and uploaded documents.
OPENWEBUI_DATA_PATH=/path/to/open-webui/data
