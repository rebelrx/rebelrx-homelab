# =============================================================================
# AdGuard Home stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# Volume paths
# -----------------------------------------------------------------------------

# Host path for /opt/adguardhome/work. Runtime state — query log, statistics,
# and the filter list cache. Optional in backups (rebuilds from filter sources
# on restore).
ADGUARD_WORK=/path/to/adguardhome/work

# Host path for /opt/adguardhome/conf. Persistent config (AdGuardHome.yaml),
# users, and custom rules. Essential for restore — include in Kopia / Borgmatic
# snapshots.
ADGUARD_CONF=/path/to/adguardhome/conf

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------
# All ports below are published on ALL interfaces so LAN clients can reach the
# resolver. DNS (53) is not variabilized — it needs to be 53 to be useful.

# Admin web UI / setup wizard port. Published on the host, and also targeted by
# the compose healthcheck and the NPM upstream — if you change it in the wizard,
# update it here and in NPM too. Want the UI reachable only behind your reverse
# proxy? Prefix its mapping in compose.yaml with 127.0.0.1:.
ADGUARD_WEBUI_PORT=3000

# Alternate admin interface port (optional, set in AdGuardHome.yaml).
# Reference only — NOT consumed by compose.
ADGUARD_ADMIN_PORT=8080

# DNS-over-TLS (DoT) host port. Published by compose.
ADGUARD_TLS_PORT=853

# DNS-over-HTTPS (DoH) host port. Published by compose.
# WARNING: 443 collides with the npm stack, which binds 0.0.0.0:443. If you run
# AdGuard alongside Nginx Proxy Manager, set this to a free host port (e.g. 8443)
# or remove the DoH line from compose.yaml if you don't need DoH.
ADGUARD_HTTPS_PORT=443
