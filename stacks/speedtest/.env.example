# =============================================================================
# Speedtest stack — environment variables
# =============================================================================
# Two independent services share this stack: Speedtest Tracker (scheduled
# Ookla tests against the public internet) and Librespeed (on-demand
# browser-driven LAN tests). They don't communicate with each other.
#
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# UID / GID for file ownership inside the containers (linuxserver convention).
# Match the user that owns the bind-mount targets on the host.
PUID=1000
PGID=1000

# Container timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Etc/UTC

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------
# Each service listens on container port 80, so they need DISTINCT host ports.
# Published on all interfaces so both UIs are reachable on your LAN out of the
# box. Prefer them behind a reverse proxy / loopback only? Prefix each mapping
# in compose.yaml with 127.0.0.1:.
# NOTE: 8080 is a common host port — change if it clashes with another service.

# Speedtest Tracker web UI.
SPEEDTEST_HTTP_PORT=8080

# Librespeed web UI.
LIBRESPEED_HTTP_PORT=8081

# -----------------------------------------------------------------------------
# Secrets — generate fresh values for a new install
# -----------------------------------------------------------------------------
# Generate commands:
#   APP_KEY:              openssl rand -base64 32 | tr -d '\n'
#   LIBRESPEED_PASSWORD:  openssl rand -base64 24 | tr -d '\n'

# Speedtest Tracker — Laravel app key for session/cookie encryption.
APP_KEY=

# Librespeed — admin password for the results-management interface at
# /results/?op=login. The main test page is public; this only gates results.
LIBRESPEED_PASSWORD=

# -----------------------------------------------------------------------------
# Speedtest Tracker
# -----------------------------------------------------------------------------

# Public URL Speedtest Tracker advertises. MUST match the NPM hostname
# exactly — wrong value breaks the UI's CSRF protection and result links.
APP_URL=https://speedtest.example.com

# URL for serving CSS/JS assets — usually identical to APP_URL.
# Mismatched values cause the UI to load with broken CSS/JS.
ASSET_URL=https://speedtest.example.com

# TZ used for rendering result timestamps in the UI. Independent from
# the container's TIMEZONE so log time and display time can differ if
# you want UTC logs but local-time graphs.
DISPLAY_TIMEZONE=Etc/UTC

# Cron schedule for automatic tests. Default: midnight daily.
#   "0 0 * * *"   — daily at 00:00
#   "0 */6 * * *" — every 6 hours
#   "*/30 * * * *" — every 30 minutes
SPEEDTEST_SCHEDULE=0 0 * * *

# Host bind for Speedtest Tracker app data — SQLite DB with full test
# history (graphs and trend data live here), config, user accounts.
# Include in Kopia / Borgmatic snapshots.
SPEEDTEST_CONFIG=/path/to/speedtest-tracker/data

# -----------------------------------------------------------------------------
# Librespeed
# -----------------------------------------------------------------------------

# Host bind for Librespeed app data — SQLite DB with on-demand test results
# and config. Include in Kopia / Borgmatic snapshots.
LIBRESPEED_CONFIG=/path/to/librespeed/config

# -----------------------------------------------------------------------------
# Reference only — not consumed by compose
# -----------------------------------------------------------------------------

# Container listen ports (hardcoded in the images):
#   Speedtest Tracker: 80 (HTTP), 443 (HTTPS, self-signed)
#   Librespeed:        80
# The host-side ports are set above (SPEEDTEST_HTTP_PORT / LIBRESPEED_HTTP_PORT).

# DB_CONNECTION (Speedtest Tracker), DB_TYPE (Librespeed), CUSTOM_RESULTS, and
# PRUNE_RESULTS_OLDER_THAN are set directly in compose.yaml's environment block,
# not pulled from .env. Edit compose to change them.
