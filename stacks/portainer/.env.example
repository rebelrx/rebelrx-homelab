# =============================================================================
# Portainer stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Host port published for the HTTPS web UI (container listens on 9443 with a
# self-signed cert; it also listens on 9000/http). Published on all interfaces
# so the UI is reachable on your LAN out of the box. Prefer it behind a reverse
# proxy / loopback only? Prefix the mapping in compose.yaml with 127.0.0.1:.
# To publish the plain-HTTP port instead, map ${PORTAINER_PORT}:9000.
PORTAINER_PORT=9443

# -----------------------------------------------------------------------------
# Volume paths
# -----------------------------------------------------------------------------

# Portainer state — admin accounts, API keys, environment definitions,
# stored stack templates, license. Essential for restore; include in
# Kopia / Borgmatic snapshots.
PORTAINER_DATA=/path/to/portainer/data
