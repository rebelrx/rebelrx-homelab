# =============================================================================
# Uptime Kuma stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# Container timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Etc/UTC

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Host port published for the web UI (the container listens on 3001). Published
# on all interfaces so it's reachable on your LAN out of the box. Prefer it
# behind a reverse proxy / loopback only? Prefix the mapping in compose.yaml
# with 127.0.0.1:.
UPTIME_PORT=3001

# -----------------------------------------------------------------------------
# Volume paths
# -----------------------------------------------------------------------------

# Uptime Kuma data directory — SQLite DB with all monitors, history,
# status pages, users, notification configs, and cert cache. The ONLY
# stateful path; include in Kopia / Borgmatic snapshots.
UPTIME_DATA=/path/to/uptimekuma

# -----------------------------------------------------------------------------
# Reference only — not consumed by compose
# -----------------------------------------------------------------------------

# UMASK is set directly in compose.yaml's environment block, not pulled
# from .env. Edit compose to change it. Current value: 0022.
