# =============================================================================
# Navidrome stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Host port published for the web UI / Subsonic API (container listens on 4533).
# Published on all interfaces so it's reachable on your LAN out of the box.
# Prefer it behind a reverse proxy / loopback only? Prefix the mapping in
# compose.yaml with 127.0.0.1:.
NAVIDROME_PORT=4533

# -----------------------------------------------------------------------------
# Volume paths
# -----------------------------------------------------------------------------

# Persistent data — SQLite DB, search index, cache, play counts, ratings,
# starred items. Essential for restore; include in Kopia / Borgmatic snapshots.
NAVIDROME_DATA_PATH=/path/to/navidrome/data

# Music library — mounted READ-ONLY into the container. Navidrome reads tags
# from files but never writes back; the :ro in compose is cheap insurance
# against bugs or misconfiguration.
NAVIDROME_MUSIC_PATH=/path/to/nas-media/music

# -----------------------------------------------------------------------------
# Optional — uncomment and set to enable
# -----------------------------------------------------------------------------
# These are read by Navidrome via env (ND_* convention). They're optional and
# inactive unless uncommented. Set inside the container's `environment:` block
# in compose.yaml if you want them active, or extend compose to read from .env.

# Spotify cover-art API. Get credentials at https://developer.spotify.com/
#ND_SPOTIFY_ID=
#ND_SPOTIFY_SECRET=

# Last.fm scrobbling. Get an API key at https://www.last.fm/api/account/create
#ND_LASTFM_APIKEY=
#ND_LASTFM_SECRET=

# Scan schedule (cron syntax). Default "@every 1m" is essentially free when
# nothing has changed; lengthen if you want to reduce idle scanning entirely.
#ND_SCANSCHEDULE=@every 1m

# -----------------------------------------------------------------------------
# Reference only — not consumed by compose
# -----------------------------------------------------------------------------

# ND_LISTENBRAINZ_ENABLED and ND_ENABLEINSIGHTSCOLLECTOR are set directly in
# compose.yaml's environment block. Edit compose to change them.
