# =============================================================================
# Cloudflared stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# Secret
# -----------------------------------------------------------------------------

# Cloudflare Tunnel token from the Zero Trust dashboard:
#   Networks → Tunnels → (your tunnel) → Install connector → copy the value
#   after `--token` in the shown command.
# Required — the container refuses to start without it (marked `:?` in compose).
TUNNEL_TOKEN=
