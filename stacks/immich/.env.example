# =============================================================================
# Immich stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
#
# Both immich-server and immich-machine-learning mount this file via env_file:,
# so EVERY variable here is also exported into those containers. Keep that in
# mind when naming vars (see IMMICH_HOST_PORT below).
# Full reference: https://immich.app/docs/install/environment-variables
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# Container timezone — used for EXIF date handling.
TZ=Etc/UTC

# Immich image tag. "release" = latest stable. Pin to a version (e.g. v1.122.3)
# to freeze upgrades. Applies to both server and ML images (ML appends -cuda).
IMMICH_VERSION=release

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Host port published for the Immich web UI / API (container listens on 2283).
# Published on all interfaces so it's reachable on your LAN out of the box.
# Prefer it behind a reverse proxy / loopback only? Prefix the mapping in
# compose.yaml with 127.0.0.1:.
#
# IMPORTANT: this is deliberately NOT named IMMICH_PORT. Because env_file passes
# every var into the container, a var named IMMICH_PORT would ALSO change the
# server's INTERNAL listen port (Immich reads IMMICH_PORT), breaking the
# published mapping. IMMICH_HOST_PORT is ignored by Immich and only used by
# compose for the host side.
IMMICH_HOST_PORT=2283

# -----------------------------------------------------------------------------
# Database — secret
# -----------------------------------------------------------------------------

# PostgreSQL password. The upstream template ships "postgres" — you MUST replace
# it. Use ONLY A-Za-z0-9 characters (no special chars/spaces): special
# characters break the connection string Immich builds internally.
# Generate with:
#   openssl rand -hex 32
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Database — defaults (safe to leave as-is)
# -----------------------------------------------------------------------------

DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# -----------------------------------------------------------------------------
# Volume paths
# -----------------------------------------------------------------------------

# Photo/video library. Can live on a NAS/NFS share (bulk media). This is the
# ONLY Immich path that's safe on a network share.
UPLOAD_LOCATION=/path/to/nas-media/immich

# PostgreSQL data dir. MUST be on LOCAL disk — network shares (NFS) are
# unsupported and will corrupt the DB under load.
DB_DATA_LOCATION=/path/to/immich/postgres

# ML model cache — models download here on first inference (~GB scale).
# Local disk recommended.
IMMICH_CACHE=/path/to/immich/ml-cache
