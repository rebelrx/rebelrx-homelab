# =============================================================================
# Filebrowser Quantum stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# Container timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Etc/UTC

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Host port published for the web UI. The container listens on 80 (hardcoded in
# the image), so the mapping is ${FILEBROWSER_PORT}:80. 8080 is chosen as a
# non-privileged host default — do NOT set this to 80, which collides with the
# npm stack and requires privilege. 8080 is itself common; change if it clashes.
#
# SECURITY: Filebrowser has read/write access to the broad host paths mounted
# below (effectively host-shell-equivalent). Strongly consider binding this to
# loopback (prefix "127.0.0.1:" in compose.yaml) behind an authenticated reverse
# proxy, or to your Tailscale IP, rather than exposing it on all interfaces.
FILEBROWSER_PORT=8080

# -----------------------------------------------------------------------------
# Source paths — browseable trees exposed in the Filebrowser UI
# -----------------------------------------------------------------------------
# Each source is registered as a named source in config.yaml and appears in
# the UI as a separate browseable tree. Add or remove sources by editing both
# compose.yaml (the volume mount) AND config.yaml (the source registration).
#
# IMPORTANT: Filebrowser has read/write access to whatever you mount here.
# Treat the admin login as equivalent to host-shell access for these paths.

# User home directory — appears in the UI as the "home" source.
FILEBROWSER_HOME_PATH=/path/to/user-home

# Legacy /srv tree — appears as "srv". Kept around for any pre-migration
# content still living under /srv on the host.
FILEBROWSER_SRV_PATH=/path/to/srv

# Stacks and container data tree (compose stacks, containers data, etc.) —
# appears as "opt". This is the current working tree post-migration.
FILEBROWSER_OPT_PATH=/path/to/opt

# -----------------------------------------------------------------------------
# App state paths
# -----------------------------------------------------------------------------

# Filebrowser app state — config.yaml, user DB, file index, sessions.
# Essential for restore; include in Kopia / Borgmatic snapshots.
#
# NOTE: config.yaml MUST exist at <this path>/config.yaml before first start.
# Filebrowser Quantum has no implicit defaults — a missing or invalid config
# causes the container to exit at startup. See README for a minimal template.
FILEBROWSER_DATA_PATH=/path/to/filebrowserquantum/data

# Temp working space — uploads in flight, archive extraction, etc.
# Volatile scratch; exclude from backups.
FILEBROWSER_TMP_PATH=/path/to/filebrowserquantum/tmp

# -----------------------------------------------------------------------------
# Reference only — not consumed by compose
# -----------------------------------------------------------------------------

# Path to config.yaml INSIDE the container. Set in compose.yaml as
# `FILEBROWSER_CONFIG=data/config.yaml` (relative to the container's working
# directory, resolving to /home/filebrowser/data/config.yaml). On the host,
# the file lives at ${FILEBROWSER_DATA_PATH}/config.yaml. Listed here as a
# pointer; edit compose.yaml to change it.
#FILEBROWSER_CONFIG=data/config.yaml
