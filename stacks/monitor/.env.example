# =============================================================================
# Monitor stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# UID / GID Grafana and Prometheus run as inside their containers. The host
# bind-mount targets (${GRAFANA_DATA} and ${PROMETHEUS_DATA}) MUST be writable
# by this UID/GID, or the containers crash on startup with permission errors.
# Pre-create with: sudo chown -R 1000:1000 <paths>
PUID=1000
PGID=1000

# Container timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Etc/UTC

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Host port published for the Grafana UI (container listens on 3000). Published
# on all interfaces so the UI is reachable on your LAN out of the box. Prefer it
# behind a reverse proxy / loopback only? Prefix the mapping in compose.yaml
# with 127.0.0.1:.
# NOTE: 3000 is a common port — change if it clashes with another service.
GRAFANA_PORT=3000

# -----------------------------------------------------------------------------
# Grafana volume paths
# -----------------------------------------------------------------------------

# Grafana SQLite DB, users, sessions, alert state, plugins.
# Must be writable by PUID:PGID. Essential for restore.
GRAFANA_DATA=/path/to/grafana/data

# Declarative provisioning — YAML files defining datasources, dashboards,
# alert rules. Small and change-tracked; consider version-controlling.
GRAFANA_PROVISIONING=/path/to/grafana/provisioning

# Dashboard JSON files referenced by provisioning.
GRAFANA_DASHBOARDS=/path/to/grafana/dashboards

# -----------------------------------------------------------------------------
# Prometheus volume paths
# -----------------------------------------------------------------------------

# Prometheus config dir. MUST contain `prometheus.yml` before first start —
# the container exits at startup if it's missing. See README for a minimal
# template. Must be writable by PUID:PGID. Small and change-tracked; consider
# version-controlling.
PROMETHEUS_CONFIG=/path/to/prometheus/config

# Time-series database (TSDB). Can grow large; optional in backups since
# historical metrics are rebuildable (re-scraped every 15s).
# Must be writable by PUID:PGID.
PROMETHEUS_DATA=/path/to/prometheus/data

# -----------------------------------------------------------------------------
# Reference only — not consumed by compose
# -----------------------------------------------------------------------------
# Prometheus and node-exporter are INTENTIONALLY not published — Prometheus has
# admin endpoints you don't want on the LAN, and node-exporter is a raw scrape
# target. Both are reached only via internal DNS over the `monitor` network.
# To expose either anyway, add a ports: mapping to that service in compose.yaml.

#PROMETHEUS_PORT=9090
#NODE_EXPORTER_PORT=9100
