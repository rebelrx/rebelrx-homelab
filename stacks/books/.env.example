# =============================================================================
# Books stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# General — applied to every container
# -----------------------------------------------------------------------------

# UID / GID for file ownership inside containers (linuxserver convention).
# Match the user that owns the bind-mount targets on the host.
PUID=1000
PGID=1000

# Container timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Etc/UTC

# -----------------------------------------------------------------------------
# Ports (published on all interfaces)
# -----------------------------------------------------------------------------
# Host ports published by compose. Published on all interfaces so the apps are
# reachable on your LAN out of the box. Prefer them behind a reverse proxy /
# loopback only? Prefix the mappings in compose.yaml with 127.0.0.1:.

# Calibre KasmVNC web session (the desktop UI). 8080 is a common port — change
# it if it clashes with another service on the host.
CALIBRE_PORT_HTTP=8080

# Calibre-Web UI.
CALIBREWEB_PORT=8083

# Kavita UI.
KAVITA_PORT=5000

# -----------------------------------------------------------------------------
# Config paths (local NVMe)
# -----------------------------------------------------------------------------

# Calibre desktop app config and KasmVNC session state.
CALIBRE_CONFIG=/path/to/calibre/config

# Calibre plugins. Small but easy to lose; include in backups.
CALIBRE_PLUGINS=/path/to/calibre/plugins

# Calibre-Web settings DB, user accounts, OPDS config.
CALIBREWEB_CONFIG=/path/to/calibre-web/config

# Kavita app DB, user accounts, library metadata, reading progress.
KAVITA_CONFIG=/path/to/kavita/config

# -----------------------------------------------------------------------------
# Library paths (NFS share on NAS)
# -----------------------------------------------------------------------------

# Calibre master library — SHARED between Calibre (writer) and Calibre-Web
# (reader). Both must agree on this path so metadata.db is in sync. If you
# relocate the library, update Calibre-Web's database location in its admin
# settings too.
CALIBRE_LIBRARY=/path/to/nas-media/books/calibre-library

# Kavita library root — points at the broader media tree so a single Kavita
# instance can serve books, comics, and audiobooks. Configure individual
# libraries inside Kavita against subpaths (/data/books, /data/comics, etc.).
KAVITA_LIBRARY=/path/to/nas-media

# -----------------------------------------------------------------------------
# Reference only — not consumed by compose
# -----------------------------------------------------------------------------

# Calibre HTTPS variant of KasmVNC. Not published — NPM terminates TLS and the
# HTTP port above is used for direct access. Publish it yourself if you want
# container-side HTTPS.
#CALIBRE_PORT_HTTPS=8181

# Calibre embedded content server (for sending books to e-readers / OPDS apps).
# Opt-in: enable it inside the Calibre desktop session, then add a
# "${CALIBRE_PORT_WEBSERVER}:8081" mapping to the calibre service to publish it.
#CALIBRE_PORT_WEBSERVER=8081
