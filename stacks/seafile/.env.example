# =============================================================================
# Seafile stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# Server identity
# -----------------------------------------------------------------------------

# Public hostname Seafile uses to build absolute URLs.
# Must match the Caddy site block on the public-edge VPS.
SEAFILE_SERVER_HOSTNAME=seafile.example.com

# Scheme Seafile uses when generating absolute URLs.
SEAFILE_SERVER_PROTOCOL=https

# Container timezone (used in logs and scheduled tasks).
TIME_ZONE=Etc/UTC

# -----------------------------------------------------------------------------
# Tailscale binding
# -----------------------------------------------------------------------------

# The home server's Tailscale IP. Used by compose to bind the published port to
# the tailscale0 interface so the public-edge VPS (Caddy) can reach this stack
# while keeping it unreachable from LAN or the public internet.
#
# Get with: tailscale ip -4
#
# IMPORTANT: also requires `net.ipv4.ip_nonlocal_bind=1` in /etc/sysctl.conf
# so Docker can bind on boot before Tailscale establishes the interface.
#
# NOT using a VPS bastion? See the README "Ports" section — you can change the
# mapping in compose.yaml to publish on all interfaces or loopback instead, and
# drop this variable.
TAILSCALE_IP=100.x.y.z

# -----------------------------------------------------------------------------
# Volume paths
# -----------------------------------------------------------------------------

# Host path for /shared (NAS-mounted). Contains config, logs, and block storage.
# Backup as a unit with the MySQL data — DB-only restore is useless without
# the content-addressed blocks under <this path>/seafile/seafile-data/storage/.
SEAFILE_DATA_PATH=/path/to/nas-data/seafile

# Host path for MariaDB data directory (local SSD).
SEAFILE_MYSQL_PATH=/path/to/seafile/mysql

# -----------------------------------------------------------------------------
# Secrets — generate fresh values for a new install
# -----------------------------------------------------------------------------
# Generate commands:
#   JWT_PRIVATE_KEY:                   openssl rand -hex 32
#   INIT_SEAFILE_MYSQL_ROOT_PASSWORD:  openssl rand -base64 32 | tr -d '\n'
#   SEAFILE_MYSQL_DB_PASSWORD:         openssl rand -base64 32 | tr -d '\n'
#   REDIS_PASSWORD:                    openssl rand -base64 32 | tr -d '\n'
#   INIT_SEAFILE_ADMIN_PASSWORD:       openssl rand -base64 24 | tr -d '\n'

# Internal service auth between seaf-server and seahub (>= 32 chars).
JWT_PRIVATE_KEY=

# MariaDB root password. ONLY consumed on first boot.
INIT_SEAFILE_MYSQL_ROOT_PASSWORD=

# Password for the `seafile` MySQL user. Consumed on every boot.
SEAFILE_MYSQL_DB_PASSWORD=

# Redis AUTH password.
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Initial admin account — ONLY consumed on first boot
# -----------------------------------------------------------------------------
# After first boot, change the admin password via the Seafile UI or:
#   docker exec -it seafile /opt/seafile/seafile-server-latest/reset-admin.sh

INIT_SEAFILE_ADMIN_EMAIL=admin@example.com
INIT_SEAFILE_ADMIN_PASSWORD=
