# =============================================================================
# RomM stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# Container timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Etc/UTC

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Host port published for the web UI (the container listens on 8080). Published
# on all interfaces so it's reachable on your LAN out of the box. Prefer it
# behind a reverse proxy / loopback only? Prefix the mapping in compose.yaml
# with 127.0.0.1:.
# NOTE: 8080 is a common host port — change if it clashes with another service.
ROMM_PORT=8080

# -----------------------------------------------------------------------------
# Secrets — generate fresh values for a new install
# -----------------------------------------------------------------------------
# Generate commands:
#   MARIADB_ROOT_PASSWORD:  openssl rand -base64 32 | tr -d '\n'
#   MARIADB_PASSWD:         openssl rand -base64 32 | tr -d '\n'
#   ROMM_AUTH_SECRET_KEY:   openssl rand -hex 32

# MariaDB root password.
MARIADB_ROOT_PASSWORD=

# MariaDB password for MARIADB_USER. Note: spelled PASSWD, not PASSWORD —
# RomM convention. Compose maps this into MariaDB's own MARIADB_PASSWORD
# variable, so both services must reference the same value through this var.
MARIADB_PASSWD=

# Session-signing secret used by RomM.
ROMM_AUTH_SECRET_KEY=

# -----------------------------------------------------------------------------
# MariaDB
# -----------------------------------------------------------------------------

MARIADB_DATABASE=romm
MARIADB_USER=romm-user

# -----------------------------------------------------------------------------
# Metadata providers — all optional, but at least IGDB is recommended
# -----------------------------------------------------------------------------
# Each provider that's enabled but has empty credentials will be skipped at
# startup with a warning. Leave any provider blank to disable it.
#
# Provider docs (signup, scopes, app registration steps):
#   https://docs.romm.app/latest/Getting-Started/Metadata-Providers/

# IGDB — preferred primary metadata provider. Twitch developer credentials.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Screenscraper.fr — user account credentials, not an API key.
SCREENSCRAPER_USER=
SCREENSCRAPER_PASSWORD=

# MobyGames API key.
MOBYGAMES_API_KEY=

# RetroAchievements API key (Web API key, not user password).
RETROACHIEVEMENTS_API_KEY=

# SteamGridDB API key — custom posters / heroes / grid art.
STEAMGRIDDB_API_KEY=

# -----------------------------------------------------------------------------
# Volume paths — RomM (local disk for state, NAS for library)
# -----------------------------------------------------------------------------

# Cover art, screenshots, and metadata images fetched from IGDB / Screenscraper.
# GB-scale; rebuildable from providers but slow on a large library.
ROMM_RESOURCES=/path/to/romm/resources

# Embedded Redis state for background tasks. Ephemeral — exclude from backups.
ROMM_DATA=/path/to/romm/redisdata

# Optional config.yml directory for advanced settings.
ROMM_CONFIG=/path/to/romm/config

# Game library — the actual ROM files. Organize per RomM folder structure:
#   https://docs.romm.app/latest/Getting-Started/Folder-Structure/
# Bulk data on NAS; backed up at the NAS level, not by Kopia/Borgmatic here.
ROMM_LIBRARY=/path/to/nas-roms/romm

# Uploaded saves, save states, user screenshots. Small but irreplaceable to
# users — include in backups.
ROMM_ASSETS=/path/to/nas-roms/romm/rommsaves

# -----------------------------------------------------------------------------
# Volume paths — MariaDB (local NVMe)
# -----------------------------------------------------------------------------

# MariaDB data directory — users, game metadata, library index state.
# MUST be on local NVMe; MariaDB on NFS is unsupported and breaks.
ROMM_MYSQL_DATA=/path/to/romm/mysqldata

# -----------------------------------------------------------------------------
# Reference only — not consumed by compose
# -----------------------------------------------------------------------------

# DB_HOST and the various *_API_ENABLED flags are set directly in compose.yaml's
# environment block, not pulled from .env. Edit compose to change them.
