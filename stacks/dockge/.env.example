# =============================================================================
# Dockge stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# Container timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Etc/UTC

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Host port published for the Dockge web UI (container listens on 5001).
# Published on all interfaces so the UI is reachable on your LAN out of the box.
# Prefer it behind a reverse proxy / loopback only? Prefix the mapping in
# compose.yaml with 127.0.0.1:.
DOCKGE_PORT=5001

# -----------------------------------------------------------------------------
# Volume paths
# -----------------------------------------------------------------------------

# Dockge state — admin accounts, agent config, UI preferences.
DOCKGE_DATA=/path/to/dockge/data

# Host path to the compose tree Dockge manages. Every stack under this dir
# becomes visible in Dockge's UI.
# IMPORTANT: this MUST equal the in-container path Dockge uses
# (DOCKGE_STACKS_DIR=/opt/stacks, set in compose.yaml). Dockge writes stack
# paths based on it, so a mismatch breaks deploy/redeploy. Keep both /opt/stacks.
DOCKGE_COMPOSE=/opt/stacks

# -----------------------------------------------------------------------------
# Reference only — not consumed by compose
# -----------------------------------------------------------------------------

# In-container path where DOCKGE_COMPOSE is mounted. Set in compose.yaml as
# `DOCKGE_STACKS_DIR=/opt/stacks` — must match the right-hand side of the
# DOCKGE_COMPOSE bind mount. Listed here as a pointer; edit compose.yaml to
# change it.
#DOCKGE_STACKS_DIR=/opt/stacks
