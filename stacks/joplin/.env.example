# =============================================================================
# Joplin Server stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
#
# This stack hosts the sync server only. Note-taking happens in the Joplin
# desktop/mobile apps; this server is what they sync to.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# Container timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Etc/UTC

# -----------------------------------------------------------------------------
# Public URL
# -----------------------------------------------------------------------------

# Public URL Joplin advertises to clients. Used in share links, registration
# emails, and the URL clients connect to. MUST match what NPM serves exactly
# — typos, trailing slashes, or http-vs-https mismatches cause share links
# and registration emails to build broken URLs (auth still works).
JOPLIN_BASE_URL=https://joplin.example.com

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Host port published for the web UI / sync API. The container listens on 22300
# (set via APP_PORT=22300 in compose.yaml). Published on all interfaces so it's
# reachable on your LAN out of the box. Prefer it behind a reverse proxy /
# loopback only? Prefix the mapping in compose.yaml with 127.0.0.1:.
JOPLIN_PORT=22300

# -----------------------------------------------------------------------------
# Secret — generate a fresh value for a new install
# -----------------------------------------------------------------------------
# Generate command:
#   POSTGRES_PASSWORD:  openssl rand -base64 32 | tr -d '\n'
#
# Used by BOTH the joplin-server (as the DB client password) and joplin-db
# (as POSTGRES_PASSWORD). They must match.

POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------

POSTGRES_USER=joplin
POSTGRES_DATABASE=joplin

# Internal hostname Joplin uses to reach the DB. Must match the joplin-db
# container name. Don't change unless you also rename the container.
POSTGRES_HOST=joplin-db

# -----------------------------------------------------------------------------
# Volume paths
# -----------------------------------------------------------------------------

# PostgreSQL data — the ONLY stateful path in this stack. All notes,
# attachments, and user accounts live here. The joplin-server container has
# no persistent volume of its own.
JOPLIN_DB_DIR=/path/to/joplin/postgres-data

# -----------------------------------------------------------------------------
# Reference only — not consumed by compose
# -----------------------------------------------------------------------------

# DB_CLIENT=pg and POSTGRES_PORT=5432 are set directly in compose.yaml.
# Edit compose to change them.
