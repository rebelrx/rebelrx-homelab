# =============================================================================
# Documenso stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# Tailscale binding
# -----------------------------------------------------------------------------

# The host's Tailscale IP. Used by compose to bind the published port to the
# tailscale0 interface so the public-edge VPS (Caddy) can reach this stack
# while keeping it unreachable from LAN or the public internet.
#
# Get with: tailscale ip -4
#
# IMPORTANT: also requires `net.ipv4.ip_nonlocal_bind=1` in /etc/sysctl.conf
# so Docker can bind on boot before Tailscale establishes the interface.
TAILSCALE_IP=100.x.y.z

# -----------------------------------------------------------------------------
# Public URLs
# -----------------------------------------------------------------------------

# Public URL — baked into all signing-request and completion email links.
# CHANGING THIS BREAKS IN-FLIGHT ENVELOPES. Complete or void pending signing
# requests before changing.
NEXT_PUBLIC_WEBAPP_URL=https://documenso.example.com

# Internal URL for container-to-container job submission. Must resolve from
# inside the container; the service name + port is correct for this stack.
NEXT_PRIVATE_INTERNAL_WEBAPP_URL=http://documenso:3000

# -----------------------------------------------------------------------------
# Secrets — generate fresh values for a new install
# -----------------------------------------------------------------------------
# Generate commands:
#   NEXTAUTH_SECRET:                          openssl rand -hex 32
#   NEXT_PRIVATE_ENCRYPTION_KEY:              openssl rand -hex 32
#   NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY:    openssl rand -hex 32
#   POSTGRES_PASSWORD:                        openssl rand -base64 32 | tr -d '\n=/+' | head -c 32
#
# CRITICAL: NEXT_PRIVATE_ENCRYPTION_KEY (and its secondary) encrypt sensitive
# DB fields at rest. If both are lost, those fields are unrecoverable even
# with the DB intact. Store both in a password manager outside this host.

# NextAuth session signing key.
NEXTAUTH_SECRET=

# Primary at-rest encryption key for stored data (min 32 chars).
NEXT_PRIVATE_ENCRYPTION_KEY=

# Secondary at-rest encryption key (for key rotation; min 32 chars).
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=

# Passphrase for the cert.p12 PKCS#12 signing certificate.
# MUST match the passphrase used when generating the cert. Store in a password
# manager — if lost, the cert must be regenerated (and previously signed
# documents still verify against the old cert embedded in their signatures).
NEXT_PRIVATE_SIGNING_PASSPHRASE=

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------

POSTGRES_USER=documenso
POSTGRES_DB=documenso
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# SMTP — Resend (default for this stack)
# -----------------------------------------------------------------------------
# Transport is hardcoded to `smtp-auth` in compose.yml. To use a different
# transport (Resend REST API, AWS SES, Mailgun), edit compose.yml and adjust
# env vars per https://docs.documenso.com/docs/self-hosting

NEXT_PRIVATE_SMTP_HOST=smtp.resend.com

# 587 = STARTTLS, 465 = implicit TLS. Both work with Resend.
NEXT_PRIVATE_SMTP_PORT=587

# For Resend SMTP the username is the literal string `resend`.
NEXT_PRIVATE_SMTP_USERNAME=resend

# Resend API key (re_...). Get from the Resend dashboard, scoped to your
# verified sending domain with "Sending access" permission.
NEXT_PRIVATE_SMTP_PASSWORD=

# Display name on outbound emails.
NEXT_PRIVATE_SMTP_FROM_NAME=Documenso

# From address. The DOMAIN must exactly match a verified Resend domain or
# Resend rejects with `550 This API key is not authorized to send emails
# from <domain>`. Use a dedicated subdomain (e.g. mail.example.com) so
# sending reputation stays isolated from your apex domain.
NEXT_PRIVATE_SMTP_FROM_ADDRESS=no-reply@mail.example.com

# -----------------------------------------------------------------------------
# Signing
# -----------------------------------------------------------------------------
# Without NEXT_PRIVATE_SIGNING_TRANSPORT=local and a valid cert file path,
# Documenso falls back to a dev-only default path that doesn't exist in the
# production container, causing the seal-document background job to fail
# silently after every signing flow.

# Local PKCS#12 file (rather than a cloud KMS).
NEXT_PRIVATE_SIGNING_TRANSPORT=local

# CONTAINER path to the cert. Must match the right-hand side of the
# DOCUMENSO_CERT volume mount below — do not edit unless you also change the
# mount target in compose.yml.
NEXT_PRIVATE_SIGNING_LOCAL_FILE_PATH=/opt/documenso/cert.p12

# -----------------------------------------------------------------------------
# Volume paths
# -----------------------------------------------------------------------------

# Host path to the PKCS#12 signing certificate. MUST exist as a regular FILE
# (not a directory) before `docker compose up`, or Docker will silently create
# a directory at this path and the bind mount becomes a directory-to-file
# mismatch. See README "Deployment — Step 1" for the correct cert placement
# procedure.
#
# Ownership: chown 1001:65533, chmod 640 (container's nodejs user).
DOCUMENSO_CERT=/path/to/documenso/certs/cert.p12

# PostgreSQL data directory.
DOCUMENSO_DB=/path/to/documenso/postgres
