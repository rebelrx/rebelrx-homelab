# =============================================================================
# Backup stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
#
# Two-tier backup: Kopia (off-host → NAS) and Borgmatic (local → NVMe).
# The two services share nothing operationally — variables are grouped
# accordingly below.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# Container timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Etc/UTC

# -----------------------------------------------------------------------------
# Kopia — secrets
# -----------------------------------------------------------------------------
# Generate commands:
#   KOPIA_UI_PASS:    openssl rand -base64 24 | tr -d '\n'
#   KOPIA_PASSWORD:   openssl rand -base64 32 | tr -d '\n'
#
# CRITICAL: KOPIA_PASSWORD encrypts the repository itself. Store a copy
# OUTSIDE this host (password manager, printed copy in secure storage).
# Without it the repository on the NAS is an unrecoverable encrypted brick.

# Kopia web UI basic-auth username.
KOPIA_UI_USER=admin

# Kopia web UI basic-auth password.
KOPIA_UI_PASS=

# Repository encryption password — different from UI auth.
KOPIA_PASSWORD=

# -----------------------------------------------------------------------------
# Kopia — server
# -----------------------------------------------------------------------------

# Container hostname. Kopia labels snapshots by user@hostname, so pin this to a
# stable, recognizable name for your host. If left to Docker's default, a random
# hostname is assigned on each container recreation and snapshot identities
# fragment. Defaults to "docker-host" if unset.
KOPIA_HOSTNAME=docker-host

# Host port published for the Kopia web UI (container listens on 51515).
# Published on all interfaces so the UI is reachable on your LAN out of the box.
# Prefer it behind a reverse proxy / loopback only? Prefix the mapping in
# compose.yaml with 127.0.0.1:.
KOPIA_UI_PORT=51515

# -----------------------------------------------------------------------------
# Kopia — paths
# -----------------------------------------------------------------------------

# Kopia client config and repository connection details.
KOPIA_CONFIG_PATH=/path/to/kopia/config

# Local cache (chunk index, metadata). Slow to rebuild if lost.
KOPIA_CACHE_PATH=/path/to/kopia/cache

# Operation logs.
KOPIA_LOG_PATH=/path/to/kopia/logs

# Temp / FUSE working dir. Used during restores; mounted with `shared` propagation.
KOPIA_TMP_PATH=/path/to/kopia/tmp

# Source tree — mounted READ-ONLY into the container. Define snapshot policies
# inside Kopia's UI on subpaths under /data (e.g. /data/containers/<app>/config).
KOPIA_LOCAL_PATH=/path/to/backup-source

# Kopia repository on the NAS (NFS-mounted on the host).
KOPIA_REPOSITORY_PATH=/path/to/nas-backup/kopia-repo

# -----------------------------------------------------------------------------
# Borgmatic — secret
# -----------------------------------------------------------------------------
# Generate command:
#   BORG_PASSPHRASE:  openssl rand -base64 32 | tr -d '\n'
#
# CRITICAL: Same warning as KOPIA_PASSWORD. Store a copy OUTSIDE this host.
# Without it the local Borg repository is unrecoverable.

BORG_PASSPHRASE=

# -----------------------------------------------------------------------------
# Borgmatic — paths
# -----------------------------------------------------------------------------

# Source tree — mounted READ-ONLY into the container.
BACKUP_SOURCE=/path/to/backup-source

# Local Borg repository on the secondary NVMe.
BACKUP_REPOSITORY=/path/to/nvme-backup/borg-repo

# Borgmatic YAML config dir — drop *.yaml files here to define sources,
# retention, hooks.
BORGMATIC_D=/path/to/borgmatic/borgmatic.d

# Borg client config (BORG_CONFIG_DIR). Despite the variable name, this is
# Borg's config, not borgmatic's.
BORGMATIC_CONFIG=/path/to/borgmatic/config

# Borg chunk index cache. Slow to rebuild if lost — persist this.
BORGMATIC_CACHE=/path/to/borgmatic/cache

# Borgmatic run state (last-run timestamps, etc.).
BORGMATIC_STATE=/path/to/borgmatic/state

# SSH dir. Unused for local-only repos; reserved for future remote backends.
# Can be empty for the current local-repo setup.
BORGMATIC_SSH=/path/to/borgmatic/ssh

# -----------------------------------------------------------------------------
# Reference only — not consumed by compose
# -----------------------------------------------------------------------------

# Borgmatic cron schedule and run-on-startup flag are set directly in
# compose.yaml, not here. Edit compose.yaml to change them.
#BACKUP_CRON=0 3 * * *
#RUN_ON_STARTUP=false
