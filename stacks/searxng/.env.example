# =============================================================================
# SearXNG stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# Public URL
# -----------------------------------------------------------------------------

# Public URL SearXNG advertises. Used for CSRF protection, redirects, and
# results links. MUST match the NPM hostname exactly — mismatches cause
# result links to point at the wrong URL and break the limiter's CSRF logic.
SEARXNG_BASE_URL=https://searxng.example.com

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Host port published for the web UI (the container listens on 8080). Published
# on all interfaces so it's reachable on your LAN out of the box. Prefer it
# behind a reverse proxy / loopback only? Prefix the mapping in compose.yaml
# with 127.0.0.1:.
# NOTE: 8080 is a common host port — change if it clashes with another service.
SEARXNG_PORT=8080

# -----------------------------------------------------------------------------
# Secret — generate a fresh value for a new install
# -----------------------------------------------------------------------------
# Generate command:
#   SEARXNG_SECRET_KEY:  openssl rand -base64 32 | tr -d '\n'

# Session-signing key.
SEARXNG_SECRET_KEY=

# -----------------------------------------------------------------------------
# Volume paths
# -----------------------------------------------------------------------------

# SearXNG config — settings.yml, engine configs, UI overrides. Generated on
# first start with upstream defaults; customize after first boot. Essential
# for restore; small and change-tracked, consider version-controlling.
SEARXNG_CONFIG=/path/to/searxng/core-config

# SearXNG runtime cache. Regenerates on demand; exclude from backups.
SEARXNG_DATA=/path/to/searxng/data

# Valkey persistence directory. Holds rate-limiter and bot-detection state.
# Ephemeral — losing it means an hour or so of "this IP was hammering" state
# resets on restore. Exclude from backups.
SEARXNG_DB_DATA=/path/to/searxng/valkey-data

# -----------------------------------------------------------------------------
# Reference only — not consumed by compose
# -----------------------------------------------------------------------------

# SEARXNG_VALKEY_URL and FORCE_OWNERSHIP are set directly in compose.yaml's
# environment block, not pulled from .env. Edit compose to change them.
