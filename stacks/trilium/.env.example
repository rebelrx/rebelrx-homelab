# =============================================================================
# Trilium stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# Container timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Etc/UTC

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Host port published for the web UI / sync API (the container listens on 8080).
# Published on all interfaces so it's reachable on your LAN out of the box.
# Prefer it behind a reverse proxy / loopback only? Prefix the mapping in
# compose.yaml with 127.0.0.1:.
# NOTE: 8080 is a common host port — change if it clashes.
TRILIUM_PORT=8080

# -----------------------------------------------------------------------------
# Volume paths
# -----------------------------------------------------------------------------

# Trilium data directory — SQLite DB (document.db), attachments, sync state,
# user config, and Trilium's own daily backup snapshots under backup/.
# The ONLY stateful path; include in Kopia / Borgmatic snapshots.
TRILIUM_DATA_DIR=/path/to/trilium
