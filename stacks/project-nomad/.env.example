# =============================================================================
# Project N.O.M.A.D. stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------
# Application signing key for the Command Center. Generate:
#   openssl rand -base64 32
NOMAD_APP_KEY=

# MySQL password for the `nomad_user` account. Consumed by both the admin
# service and the mysql container — they read the same variable, so it only
# needs to be set once here. Generate:
#   openssl rand -base64 32
NOMAD_DB_PASSWORD=

# MySQL root password. Generate:
#   openssl rand -base64 32
NOMAD_MYSQL_ROOT_PASSWORD=

# -----------------------------------------------------------------------------
# Public URL
# -----------------------------------------------------------------------------
# Public URL the Command Center advertises to clients. Must EXACTLY match the
# hostname the stack is reached at through NPM — used to build share links and
# admin-generated URLs. If wrong, generated links point at the wrong host.
NOMAD_URL=https://nomad.example.com

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------
# Host port published for the Command Center web UI. The container listens on
# 8080 (set via PORT=8080 hardcoded in compose.yaml). Published on all interfaces
# so the UI is reachable on your LAN out of the box. Prefer it behind a reverse
# proxy / loopback only? Prefix the mapping in compose.yaml with 127.0.0.1:.
# NOTE: 8080 is a common host port — change if it clashes with another service.
NOMAD_PORT=8080

# -----------------------------------------------------------------------------
# Storage path (dedicated NVMe)
# -----------------------------------------------------------------------------
# Content packs, downloaded knowledge (ZIM files), AI models, RAG knowledge
# base, and user data. Mounted into BOTH the admin (`/app/storage`) and
# disk-collector (`/storage`) containers via this single variable. Can grow to
# hundreds of GB, so it lives on a dedicated NVMe drive, NOT the root drive.
#
# Ensure the NVMe drive is mounted before bringing up the stack. Docker carries
# a RequiresMountsFor= dependency on this mount in its service drop-in, so the
# stack won't write to a bare mountpoint if the disk is ever unmounted.
#
# Essential content (user data, RAG base) belongs in backups; the bulk
# re-downloadable content under <storage>/downloads/ can be excluded.
NOMAD_STORAGE_PATH=/path/to/nvme-storage/project-nomad/storage

# -----------------------------------------------------------------------------
# Local config paths (root filesystem)
# -----------------------------------------------------------------------------
# MySQL data — Command Center DB (users, settings, content-pack metadata,
# notes/markers). Small and essential for restore; include in backups.
NOMAD_MYSQL_PATH=/path/to/project-nomad/mysql

# Redis persistence. Ephemeral cache, but small and cheap to snapshot.
NOMAD_REDIS_PATH=/path/to/project-nomad/redis

# Updater working dir — MUST point at this stack's own compose tree. The
# updater sidecar mounts it at /opt/project-nomad and rewrites compose.yaml in
# place during version upgrades. Set this to the directory containing this file.
NOMAD_UPDATER_PATH=/path/to/compose/project-nomad

# -----------------------------------------------------------------------------
# Reference only — not consumed by compose
# -----------------------------------------------------------------------------
# The values below are hardcoded directly in compose.yaml (Project NOMAD bakes
# most config into the compose tree). Listed here for visibility only — setting
# them in .env has no effect.
#
# Command Center internal listen port (container side of ${NOMAD_PORT}:8080).
#PORT=8080
# Node runtime mode and admin log verbosity.
#NODE_ENV=production
#LOG_LEVEL=info
# Internal service hostnames — match the container names on the nomad network.
#DB_HOST=mysql
#REDIS_HOST=redis
# Fixed DB identifiers, created by the mysql container on first run.
#DB_NAME=nomad
#DB_USER=nomad_user
# Dozzle hardening — container start/stop actions and web-shell disabled.
#DOZZLE_ENABLE_ACTIONS=false
#DOZZLE_ENABLE_SHELL=false
