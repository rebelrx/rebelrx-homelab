# =============================================================================
# Paperless-ngx stack — compose interpolation variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
#
# Paperless splits config across TWO env files:
#   .env                  — compose-side: host paths and ports (THIS FILE)
#   docker-compose.env    — container runtime: app config, secrets, DB creds
#
# The webserver AND db load docker-compose.env via `env_file:` in compose.yaml.
# Both files are .example-committed and must be created locally before
# bringing the stack up.
# =============================================================================

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Host port published for the web UI (container listens on 8000). Published on
# all interfaces so it's reachable on your LAN out of the box. Prefer it behind
# a reverse proxy / loopback only? Prefix the mapping in compose.yaml with
# 127.0.0.1:.
PAPERLESS_PORT=8000

# -----------------------------------------------------------------------------
# Volume paths — document library and app state
# -----------------------------------------------------------------------------
# These typically live on NAS storage so the document library has redundancy.
# Postgres data (below) is the exception — must be local NVMe.

# Search index, classifier model, internal state.
PAPERLESS_DATA=/path/to/nas-data/paperless/data

# Stored documents (originals + archive PDFs). The actual library — bulk
# storage. On a fresh install this directory will be empty; Paperless
# populates it as documents are consumed.
PAPERLESS_MEDIA=/path/to/nas-data/paperless/media

# Drop-zone for `document_exporter` runs (pre-upgrade backups, portable
# library dumps). Transient — doesn't need backups.
PAPERLESS_EXPORT=/path/to/nas-data/paperless/export

# Watch folder — files dropped here get auto-ingested by the consumer.
# Polled every 10s (set in docker-compose.env as PAPERLESS_CONSUMER_POLLING).
# Transient — doesn't need backups.
PAPERLESS_CONSUME=/path/to/nas-data/paperless/consume

# -----------------------------------------------------------------------------
# Volume paths — PostgreSQL (local NVMe)
# -----------------------------------------------------------------------------

# PostgreSQL root directory. Note: mounts the PARENT of `data/` per Paperless's
# official compose recipe. Don't "fix" this to /var/lib/postgresql/data — it
# matches upstream.
# MUST be on local NVMe. NFS will break Postgres.
PAPERLESS_PGDATA=/path/to/paperless/pgdata
