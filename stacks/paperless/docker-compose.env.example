###############################################################################
# Paperless-ngx settings                                                      #
###############################################################################
# Container runtime config for the Paperless stack — loaded by BOTH the
# webserver and the db service via `env_file: docker-compose.env`.
# Copy to docker-compose.env and fill in real values. NEVER commit the real
# file to git.   chmod 600 docker-compose.env
#
# See https://docs.paperless-ngx.com/configuration/ for all available options.
###############################################################################

# The UID and GID of the user used to run paperless in the container. Set this
# to your UID and GID on the host so that you have write access to the
# consumption directory.
#USERMAP_UID=1000
#USERMAP_GID=1000

# Public URL Paperless is served at. REQUIRED — must match exactly what users
# reach it at (scheme + host). Used for CSRF/CORS; a mismatch breaks login with
# "Forbidden (CSRF cookie not set)".
PAPERLESS_URL=https://paperless.example.com

# Django secret key — session/token signing. MUST be set to a long random
# string. Generate with:
#   openssl rand -base64 64 | tr -d '\n'
PAPERLESS_SECRET_KEY=

# Timezone for the Paperless containers. Defaults to UTC.
PAPERLESS_TIME_ZONE=Etc/UTC

# The default language to use for OCR. Set this to the language most of your
# documents are written in.
#PAPERLESS_OCR_LANGUAGE=eng

# Additional languages to install for text recognition, whitespace-separated.
# The container installs English, German, Italian, Spanish and French by default.
# See https://packages.debian.org/search?keywords=tesseract-ocr-&searchon=names
#PAPERLESS_OCR_LANGUAGES=tur ces

PAPERLESS_FILENAME_FORMAT={{ document_type }}/{{ correspondent }}/{{ created_year }}/{{ title }}
PAPERLESS_CONSUMER_RECURSIVE=true
PAPERLESS_CONSUMER_SUBDIRS_AS_TAGS=true
PAPERLESS_APP_TITLE=Paperless-ngx
PAPERLESS_CONSUMER_POLLING=10

# Postgres Environment
# ---------------------
# POSTGRES_PASSWORD (used by the db container to init the account) and
# PAPERLESS_DBPASS (used by the webserver to CONNECT to that account) MUST be
# IDENTICAL — they are the same account's password from two sides. Set both to
# the same random value.
# Generate with:  openssl rand -base64 32 | tr -d '\n'
POSTGRES_DB=paperless
POSTGRES_USER=paperless
POSTGRES_PASSWORD=
PAPERLESS_DBPASS=

# Webserver Environment
PAPERLESS_REDIS=redis://broker:6379
PAPERLESS_DBHOST=db
PAPERLESS_TIKA_ENABLED=1
PAPERLESS_TIKA_GOTENBERG_ENDPOINT=http://gotenberg:3000
PAPERLESS_TIKA_ENDPOINT=http://tika:9998
