# =============================================================================
# Jellyfin stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# UID / GID for file ownership inside the container (linuxserver convention).
# Match the user that owns the bind-mount targets on the host.
PUID=1000
PGID=1000

# Container timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Etc/UTC

# -----------------------------------------------------------------------------
# Public URL
# -----------------------------------------------------------------------------

# Public URL Jellyfin advertises to clients. Must exactly match the URL the
# mobile / TV apps reach Jellyfin at — used to build absolute links for deep
# linking and remote-streaming session reporting. If wrong, the mobile app
# builds broken URLs when reporting playback state back to the server.
JELLYFIN_PUBLISHED_SERVER_URL=https://jellyfin.example.com

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Host port published for the web UI, mapped to the container's 8096.
# CONSUMED by compose (ports: "${JELLYFIN_HTTP_PORT}:8096"). Bound to ALL
# interfaces on purpose — TV/console apps that can't use a reverse-proxied HTTPS
# endpoint reach Jellyfin directly at http://<host-ip>:${JELLYFIN_HTTP_PORT}.
# To restrict it to one interface, change the mapping in compose.yaml to
# <ip>:${JELLYFIN_HTTP_PORT}:8096 (or 127.0.0.1: for loopback).
JELLYFIN_HTTP_PORT=8096

# -----------------------------------------------------------------------------
# Config paths (local NVMe)
# -----------------------------------------------------------------------------

# Jellyfin config, SQLite DB, users, plugins, and metadata cache. Essential
# for restore — include in Kopia / Borgmatic snapshots. The metadata cache
# under <config>/data/metadata can grow to several GB; rebuildable but slow.
JELLYFIN_CONFIG=/path/to/jellyfin/config

# Transcode scratch space. MUST be local NVMe — Jellyfin writes intermediate
# transcode segments at high frequency, NFS latency causes playback stutter.
# Volatile; exclude from backups.
JELLYFIN_TRANSCODE=/path/to/jellyfin/transcode

# -----------------------------------------------------------------------------
# Media library paths (NFS share on NAS)
# -----------------------------------------------------------------------------
# Ensure the NAS share is mounted before bringing up the stack. To add another
# library (audiobooks, comics, etc.), add a new explicit mount in compose.yaml
# and a corresponding variable here — don't reach into a catch-all root.

JELLYFIN_MOVIES=/path/to/nas-media/movies
JELLYFIN_TV=/path/to/nas-media/tv
JELLYFIN_MUSIC=/path/to/nas-media/music

# -----------------------------------------------------------------------------
# Reference only — not consumed by compose
# -----------------------------------------------------------------------------

# Container HTTPS listen port. Unused — NPM terminates TLS upstream.
#JELLYFIN_HTTPS_PORT=8920

# NVIDIA_VISIBLE_DEVICES and NVIDIA_DRIVER_CAPABILITIES are set directly in
# compose.yaml (currently `all` for both). Edit compose to scope them down to
# `video,utility` if you want minimum-privilege GPU access.
