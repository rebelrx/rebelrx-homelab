# =============================================================================
# Authentik stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
#
# Both server and worker also load this file via `env_file: .env`, so any
# AUTHENTIK_* variable set here is passed into the containers in addition to
# compose-level interpolation. Add upstream-supported AUTHENTIK_* settings
# (email, error reporting, etc.) freely.
# =============================================================================

# -----------------------------------------------------------------------------
# Image version
# -----------------------------------------------------------------------------
# Authentik ships breaking changes between minors AND has occasional bad
# :latest releases (e.g. the 2026.2.x → 2026.x.x Redis regression). Pin to
# a known-good version and bump deliberately after reading release notes:
#   https://goauthentik.io/docs/releases/
#
# To update: change this value, then `docker compose up -d`. No compose edit
# needed. Take a Postgres dump first — migrations are sometimes one-way.

AUTHENTIK_TAG=2026.2.3

# -----------------------------------------------------------------------------
# Secrets — generate fresh values for a new install
# -----------------------------------------------------------------------------
# Generate commands:
#   AUTHENTIK_SECRET_KEY:  openssl rand -base64 60 | tr -d '\n'
#   PG_PASS:               openssl rand -base64 32 | tr -d '\n'
#
# Both are marked `:?` in compose — the stack refuses to start if either is
# empty. A working backup of AUTHENTIK_SECRET_KEY is essential: restoring the
# database without the matching key cannot decrypt stored credentials.

AUTHENTIK_SECRET_KEY=
PG_PASS=

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------

# Database name and user. Safe to leave as defaults for a fresh install;
# changing them after first boot requires a manual migration.
PG_DB=authentik
PG_USER=authentik

# -----------------------------------------------------------------------------
# Authentik runtime settings
# -----------------------------------------------------------------------------

# Sentry error reporting toggle. true | false
AUTHENTIK_ERROR_REPORTING__ENABLED=true

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------
# Host ports published for the server's HTTP / HTTPS listeners (container ports
# 9000/9443 are fixed in the upstream image). Published on all interfaces so the
# UI is reachable on your LAN out of the box. Prefer it behind a reverse proxy /
# loopback only? Prefix the mappings in compose.yaml with 127.0.0.1:.
# NOTE: 9000 is a common default (Portainer uses it too) — change these if they
# clash with another service on the host.

COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443

# -----------------------------------------------------------------------------
# Volume paths
# -----------------------------------------------------------------------------

# Application data, media uploads, and blueprints. Used by server and worker.
AUTHENTIK_DATA=/path/to/authentik/data

# Custom email templates. Used by server and worker.
AUTHENTIK_TEMPLATES=/path/to/authentik/custom-templates

# Outpost certificate storage. Used by worker.
AUTHENTIK_CERTS=/path/to/authentik/certs

# PostgreSQL data directory. Used by db.
AUTHENTIK_DATABASE=/path/to/authentik/postgresql/data
