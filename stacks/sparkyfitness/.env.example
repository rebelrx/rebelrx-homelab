# =============================================================================
# SparkyFitness stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
#
# NOTE: this is trimmed from the upstream template to the variables THIS stack's
# compose.yaml actually consumes, plus the common optional integrations as a
# commented reference at the bottom. Full reference:
#   https://codewithcj.github.io/SparkyFitness/install/environment-variables
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# UID / GID for file ownership on the bind mounts.
PUID=1000
PGID=1000

# Server timezone — TZ database name (e.g. America/New_York).
TZ=Etc/UTC

# Server logging verbosity: ERROR, WARN, INFO, DEBUG.
SPARKY_FITNESS_LOG_LEVEL=ERROR

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Host port for the frontend (nginx SPA + /api proxy; container listens on 80).
# Published on all interfaces so it's reachable on your LAN out of the box.
# Prefer NPM/loopback only? Prefix the mapping in compose.yaml with 127.0.0.1:.
# NOTE: upstream warns this app is NOT production-hardened — do not port-forward
# it to the public internet. LAN + reverse proxy (+ VPN/Tailscale for remote) only.
SPARKY_FITNESS_FRONTEND_PORT=3004

# Host port for the MCP server. Bound to 127.0.0.1 in compose.yaml on purpose —
# it's an authenticated API into your entire health dataset and the AI/MCP
# feature is beta. Reach it locally or over a VPN/tailnet; don't expose it.
SPARKY_FITNESS_MCP_PORT=3001

# -----------------------------------------------------------------------------
# Frontend URL & CORS
# -----------------------------------------------------------------------------

# Public URL of the frontend. CRITICAL for CORS — MUST match the hostname users
# actually reach the app at (your NPM hostname), or every API request from the
# SPA is rejected at CORS preflight.
SPARKY_FITNESS_FRONTEND_URL=https://sparkyfitness.example.com

# Allow CORS from RFC1918 ranges (10/8, 172.16/12, 192.168/16, localhost).
# Leave false — the configured FRONTEND_URL handles access. Only enable on a
# trusted private network if you access by raw LAN IP.
ALLOW_PRIVATE_NETWORK_CORS=false

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

SPARKY_FITNESS_DB_NAME=sparkyfitness_db

# Superuser for DB init and migrations.
SPARKY_FITNESS_DB_USER=sparky

# DB hostname — the compose service name on sparkyfitness_net.
SPARKY_FITNESS_DB_HOST=sparkyfitness-db

# Runtime application user (limited privileges, created on first boot).
SPARKY_FITNESS_APP_DB_USER=sparky_app

# -----------------------------------------------------------------------------
# Secrets — generate fresh values for a new install
# -----------------------------------------------------------------------------
# Generate commands:
#   SPARKY_FITNESS_DB_PASSWORD:       openssl rand -hex 32
#   SPARKY_FITNESS_APP_DB_PASSWORD:   openssl rand -hex 32
#   SPARKY_FITNESS_API_ENCRYPTION_KEY: openssl rand -hex 32   (must be 64-hex)
#   BETTER_AUTH_SECRET:               openssl rand -hex 32

# Superuser (POSTGRES_PASSWORD) password.
SPARKY_FITNESS_DB_PASSWORD=

# Application DB user password. Can be rotated post-init.
SPARKY_FITNESS_APP_DB_PASSWORD=

# --- DO NOT CHANGE POST-INIT ---
# Encrypts external-provider API credentials (Fitbit, Withings, etc.) at rest.
# Changing this invalidates all stored external-provider creds — you'd have to
# re-link every integration. 64-character hex string.
SPARKY_FITNESS_API_ENCRYPTION_KEY=

# Signs sessions and encrypts TOTP/2FA secrets. Changing this LOCKS OUT every
# user who has 2FA enabled (they'd have to disable TOTP first). Set once, back up.
BETTER_AUTH_SECRET=

# -----------------------------------------------------------------------------
# Signup & admin
# -----------------------------------------------------------------------------

# Blocks new registrations. Start false to create the first account, then flip
# to true and recreate the server for single-user lockdown.
SPARKY_FITNESS_DISABLE_SIGNUP=false

# Fail-safe: keeps email/password login enabled even if OIDC is later broken.
SPARKY_FITNESS_FORCE_EMAIL_LOGIN=true

# Optional — auto-grant admin to this email on startup (set BEFORE first signup).
#SPARKY_FITNESS_ADMIN_EMAIL=

# -----------------------------------------------------------------------------
# Volume paths
# -----------------------------------------------------------------------------

# Postgres data directory parent (Postgres uses a ./data subdir inside it).
DB_PATH=/path/to/sparkyfitness/postgresql

# Server-generated DB backups (db_backup.sh output).
SERVER_BACKUP_PATH=/path/to/sparkyfitness/backup

# User uploads — profile pictures, exercise images, AI vision inputs.
SERVER_UPLOADS_PATH=/path/to/sparkyfitness/uploads

# -----------------------------------------------------------------------------
# Email (optional) — leave blank to disable outbound email
# -----------------------------------------------------------------------------
# Defined (blank) so compose doesn't warn about unset variables. Fill in to
# enable password-reset / notification email.

SPARKY_FITNESS_EMAIL_HOST=
SPARKY_FITNESS_EMAIL_PORT=
SPARKY_FITNESS_EMAIL_SECURE=
SPARKY_FITNESS_EMAIL_USER=
SPARKY_FITNESS_EMAIL_PASS=
SPARKY_FITNESS_EMAIL_FROM=

# -----------------------------------------------------------------------------
# Reference only — not consumed by this compose
# -----------------------------------------------------------------------------

# Internal ports (hardcoded in compose.yaml, not pulled from .env):
#   SPARKY_FITNESS_SERVER_PORT=3010   (backend, internal to sparkyfitness_net)
#   SPARKY_FITNESS_DB_PORT=5432       (Postgres, internal)

# Extra origins Better Auth should trust (e.g. raw LAN-IP access). Not consumed
# by this compose; documented for completeness.
#   SPARKY_FITNESS_EXTRA_TRUSTED_ORIGINS=http://192.168.1.100:3004,http://10.0.0.5:3004

# --- OIDC (optional; not wired into this compose) ---
#SPARKY_FITNESS_OIDC_AUTH_ENABLED=true
#SPARKY_FITNESS_OIDC_ISSUER_URL=https://auth.example.com/application/o/{{slug}}/
#SPARKY_FITNESS_OIDC_CLIENT_ID=
#SPARKY_FITNESS_OIDC_CLIENT_SECRET=
#SPARKY_FITNESS_OIDC_PROVIDER_SLUG=my-idp
#SPARKY_FITNESS_OIDC_PROVIDER_NAME=My IdP
#SPARKY_FITNESS_OIDC_SCOPE=openid email profile
#SPARKY_FITNESS_OIDC_ADMIN_GROUP=Admin

# --- Garmin integration (optional; garmin microservice not deployed here) ---
#GARMIN_MICROSERVICE_URL=http://sparkyfitness-garmin:8000
#GARMIN_SERVICE_PORT=8000
#GARMIN_SERVICE_IS_CN=false

# --- Vision API for food-image analysis (optional) ---
#VISION_API_PROVIDER=gemini
#VISION_API_KEY=
