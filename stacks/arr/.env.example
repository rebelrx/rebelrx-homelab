# =============================================================================
# arr stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# General — applied to every container
# -----------------------------------------------------------------------------

# UID / GID for file ownership inside containers (linuxserver convention).
# Match the user that owns the bind-mount targets on the host.
PUID=1000
PGID=1000

# Container timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Etc/UTC

# -----------------------------------------------------------------------------
# Gluetun / VPN
# -----------------------------------------------------------------------------
# Full provider list: https://github.com/qdm12/gluetun-wiki/blob/main/setup/providers.md

# Gluetun provider key (e.g. mullvad, protonvpn, airvpn, nordvpn, ...).
VPN_SERVICE_PROVIDER=

# Tunnel protocol — wireguard or openvpn.
VPN_TYPE=wireguard

# WireGuard client private key from your provider.
WIREGUARD_PRIVATE_KEY=

# WireGuard interface address from your provider (e.g. 10.x.x.x/32).
WIREGUARD_ADDRESSES=

# Comma-separated city allowlist for server selection (e.g. "New York,Chicago").
# Leave empty to allow any city in the provider's pool.
SERVER_CITIES=

# Keep the host/upstream nameserver instead of Gluetun's built-in DNS.
# on | off
DNS_KEEP_NAMESERVER=on

# Subnets allowed to send traffic INTO Gluetun. Must include any LAN range
# that needs to reach the VPN-routed UIs, plus the Tailscale CGNAT range
# if reaching via Tailscale (e.g. "192.168.1.0/24,100.64.0.0/10").
# NOTE: the qBittorrent / SABnzbd / Prowlarr host ports are published via the
# gluetun service, so this MUST also include the Docker bridge range those
# published ports arrive from (typically 172.x.0.0/16) for them to be reachable.
FIREWALL_INPUT_SUBNETS=

# Subnets Gluetun is allowed to reach OUTBOUND (bypassing the tunnel).
# Critical: must include the Docker network range that media_net uses
# (typically 172.x.0.0/16) so the *arr containers can reach gluetun:<port>.
# Include LAN + Tailscale ranges here too.
FIREWALL_OUTBOUND_SUBNETS=

# -----------------------------------------------------------------------------
# qBittorrent — VPN-routed
# -----------------------------------------------------------------------------

# Web UI port. Intentionally 8090 to avoid colliding with SABnzbd's 8080 inside
# Gluetun's shared namespace. Published on the host via the gluetun service;
# NPM's qbittorrent upstream also targets this.
QBITTORRENT_WEBUI_PORT=8090

# BitTorrent listen port (TCP/UDP). Set inside the container and forwarded by
# your VPN provider if they offer port forwarding — NOT published on the host.
QBITTORRENT_TORRENTING_PORT=6881

# -----------------------------------------------------------------------------
# Published web-UI ports (host side, published on all interfaces)
# -----------------------------------------------------------------------------
# Each value is the HOST port compose publishes for that service's web UI, so
# the UIs are reachable on your LAN without a reverse proxy. To restrict one to
# loopback (behind NPM only), prefix its mapping in compose.yaml with 127.0.0.1:.
#
# SABnzbd / Prowlarr are published on the gluetun service (shared namespace) —
# see FIREWALL_INPUT_SUBNETS above.

SABNZBD_PORT=8080
PROWLARR_PORT=9696
RADARR_PORT=7878
SONARR_PORT=8989
LIDARR_PORT=8686
WHISPARR_PORT=6969
LAZYLIBRARIAN_PORT=5299
BAZARR_PORT=6767
SEERR_PORT=5055

# WARNING: Mylar3 defaults to 8090, which COLLIDES with qBittorrent's web UI
# (also 8090, published on the host via gluetun). You cannot bind both to 8090 —
# change this to a free host port (e.g. 8091) before starting the stack, or the
# mylar3 container will fail to start.
MYLAR_PORT=8090

# -----------------------------------------------------------------------------
# Shared download paths — single source of truth
# -----------------------------------------------------------------------------
# Every download client AND every *arr that needs them references these paths,
# so hardlink / atomic-move behaviour is guaranteed by construction. To
# relocate downloads, change these lines only.

# Torrent landing directory. qBittorrent writes here; every *arr reads.
TORRENTS_PATH=/path/to/nas-media/torrents

# Usenet completed downloads. SABnzbd writes here; every *arr reads.
USENET_COMPLETE_PATH=/path/to/nas-media/usenet/complete

# Usenet in-flight downloads. SABnzbd only — kept separate so partial files
# don't get picked up by *arr import scans.
USENET_INCOMPLETE_PATH=/path/to/nas-media/usenet/incomplete

# -----------------------------------------------------------------------------
# Media library paths (NFS share on NAS)
# -----------------------------------------------------------------------------
# Each library path is bind-mounted into the relevant *arr (and Bazarr, where
# applicable). Ensure the NAS share is mounted before bringing up the stack.

TV_PATH=/path/to/nas-media/tv
MOVIES_PATH=/path/to/nas-media/movies
MUSIC_PATH=/path/to/nas-media/music
BOOKS_PATH=/path/to/nas-media/books
COMICS_PATH=/path/to/nas-media/comics
XXX_PATH=/path/to/nas-media/xxx

# Mylar3 staging directory — incoming comics land here before processing.
COMICS_STAGING=/path/to/nas-media/_staging/comics

# -----------------------------------------------------------------------------
# Config paths (local NVMe, one per service)
# -----------------------------------------------------------------------------

QBITTORRENT_CONFIG=/path/to/qbittorrent/config
SABNZBD_CONFIG=/path/to/sabnzbd/config
PROWLARR_CONFIG=/path/to/prowlarr/config
RADARR_CONFIG=/path/to/radarr/config
SONARR_CONFIG=/path/to/sonarr/config
LIDARR_CONFIG=/path/to/lidarr/config
WHISPARR_CONFIG=/path/to/whisparr/config
LAZYLIBRARIAN_CONFIG=/path/to/lazylibrarian/config
MYLAR_CONFIG=/path/to/mylar3/config
BAZARR_CONFIG=/path/to/bazarr/config
SEERR_CONFIG=/path/to/seerr/config
