# =============================================================================
# Mealie stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# UID / GID for file ownership inside the container.
PUID=1000
PGID=1000

# Container timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Etc/UTC

# -----------------------------------------------------------------------------
# Public URL
# -----------------------------------------------------------------------------

# Public URL Mealie advertises to clients. Used in share links and email
# invitations. MUST match the NPM hostname exactly — diverging values still
# authenticate, but share links and emails build broken URLs.
URL=https://mealie.example.com

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Host port published for the web UI. The container listens on 9000; Mealie's
# docs use 9925 as the host port (9925:9000), kept here as the default.
# Published on all interfaces so it's reachable on your LAN out of the box.
# Prefer it behind a reverse proxy / loopback only? Prefix the mapping in
# compose.yaml with 127.0.0.1:.
MEALIE_PORT=9925

# -----------------------------------------------------------------------------
# Secret — generate a fresh value for a new install
# -----------------------------------------------------------------------------
# Generate command:
#   POSTGRES_PASSWORD:  openssl rand -base64 32 | tr -d '\n'
#
# Used by BOTH the mealie service (as the DB client password) and postgres
# (as POSTGRES_PASSWORD). They must match.

POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------

POSTGRES_USER=mealie
POSTGRES_DB=mealie

# Used by Postgres CLI tools (pg_isready healthcheck). Must match POSTGRES_USER.
PGUSER=mealie

# -----------------------------------------------------------------------------
# Volume paths
# -----------------------------------------------------------------------------

# App data — recipe images, attachments, backup files, app state.
MEALIE_DATA=/path/to/mealie/data

# PostgreSQL data — all recipes, meal plans, users, shopping lists.
MEALIE_PGDATA=/path/to/mealie/pgdata

# -----------------------------------------------------------------------------
# Reference only — not consumed by compose
# -----------------------------------------------------------------------------

# Postgres listen port. Set in compose.yaml as `POSTGRES_PORT=5432` on the
# mealie service. Documented for visibility only.
#POSTGRES_PORT=5432

# ALLOW_SIGNUP, DB_ENGINE, and POSTGRES_SERVER are hardcoded in compose.yaml's
# environment block — not pulled from .env. Edit compose to change them.
