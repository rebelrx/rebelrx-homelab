# =============================================================================
# Forgejo stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# UID / GID Forgejo runs as inside the container. Must own ${FORGEJO_DATA} on
# the host. NOTE: the forgejo-runner container runs as 1001:1001 regardless
# of these values — see ${FORGEJO_RUNNER_DATA} ownership note below.
USER_UID=1000
USER_GID=1000

# Container timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Etc/UTC

# -----------------------------------------------------------------------------
# Secret — generate a fresh value for a new install
# -----------------------------------------------------------------------------
# Generate command:
#   FORGEJO_DB_PASSWORD:  openssl rand -base64 32 | tr -d '\n'
#
# Used by BOTH the forgejo service (as the DB client password) and the db
# service (as POSTGRES_PASSWORD). They must match.

FORGEJO_DB_PASSWORD=

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Host port published for the Forgejo web UI + git-over-HTTPS (the container
# listens on 3000). Published on all interfaces so it's reachable on your LAN
# out of the box. Prefer it behind a reverse proxy / loopback only? Prefix the
# mapping in compose.yaml with 127.0.0.1:.
# NOTE: 3000 is a common port (documenso, Grafana, etc.) — change if it clashes.
# This is the HOST side; to change Forgejo's INTERNAL port, edit app.ini at
# ${FORGEJO_DATA}/gitea/conf/app.ini.
FORGEJO_HTTP_PORT=3000

# -----------------------------------------------------------------------------
# Volume paths
# -----------------------------------------------------------------------------

# Forgejo data — repositories, LFS storage, attachments, app.ini.
# Must be writable by USER_UID:USER_GID above. Essential for restore.
FORGEJO_DATA=/path/to/forgejo/data

# PostgreSQL data directory.
FORGEJO_DB_DATA=/path/to/forgejo/db

# Forgejo Actions runner state — registration token (.runner), runner-config.yml,
# and job cache.
#
# IMPORTANT: this directory MUST be owned by UID/GID 1001:1001 on the host
# (the runner image runs as 1001, regardless of USER_UID above). Pre-create
# before first start:
#
#   sudo mkdir -p /path/to/forgejo-runner/data
#   sudo chown -R 1001:1001 /path/to/forgejo-runner/data
#
# Without correct ownership the runner crash-loops with permission errors.
FORGEJO_RUNNER_DATA=/path/to/forgejo-runner/data

# -----------------------------------------------------------------------------
# Reference only — not consumed by compose
# -----------------------------------------------------------------------------

# FORGEJO__* environment variables (database connection, etc.) are set
# directly in compose.yaml — not pulled from .env. Configuration beyond what
# compose sets lives in app.ini, generated on first run.
