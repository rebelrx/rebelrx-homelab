# =============================================================================
# Nextcloud AIO stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
#
# This stack uses Nextcloud's "all-in-one" mastercontainer pattern: compose
# defines ONE service (the mastercontainer), which spawns and manages ~8-12
# sibling containers via the Docker socket. The variables below configure
# the mastercontainer; the spawned containers are configured through the AIO
# setup UI on first run.
# =============================================================================

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Host port for the AIO management UI (the setup wizard / admin panel).
# Loopback-bound in compose — this is the SSH-tunnel fallback for direct
# access when NPM isn't available. Day-to-day admin happens via NPM.
AIO_MANAGEMENT_PORT=8080

# Port AIO publishes for the spawned `nextcloud-aio-apache` container.
# Not actually required for NPM routing (NPM uses container DNS over the
# nextcloud-aio network) but AIO publishes it by default.
APACHE_PORT=11000

# Interface AIO binds Apache to inside the spawned container.
# Use 0.0.0.0 so NPM can reach it across Docker networks.
APACHE_IP_BINDING=0.0.0.0

# -----------------------------------------------------------------------------
# Domain validation
# -----------------------------------------------------------------------------

# AIO normally validates that the public domain you configure in the setup UI
# resolves to this host from the public internet. Set true to skip — required
# for Tailscale-only deployments where the domain (e.g. *.tail.example.net)
# isn't publicly resolvable by design.
SKIP_DOMAIN_VALIDATION=true

# -----------------------------------------------------------------------------
# Volume paths
# -----------------------------------------------------------------------------

# Host path AIO passes to the spawned Nextcloud container as the user-data
# root (files, attachments, app data). This is where bulk Nextcloud storage
# lives — point at NAS-backed storage if you have it.
#
# DO NOT include this path in Kopia / Borgmatic snapshots directly — use AIO's
# built-in BorgBackup feature instead (see README "Backup"). File-level
# snapshots of live Nextcloud data can produce inconsistent archives.
NEXTCLOUD_DATADIR=/path/to/nas-data/nextcloud-aio/ncdata

# -----------------------------------------------------------------------------
# Reference only — not in .env
# -----------------------------------------------------------------------------
# These are set directly in compose.yml's environment block, not pulled from
# .env. Edit compose to change them.
#
# NEXTCLOUD_MOUNT=/mnt
#   Tells AIO that /mnt is the root path for external-storage mounts. The
#   /mnt:/mnt bind in compose exposes the wider NAS tree to AIO so Nextcloud
#   can add external-storage entries. Wide blast radius — treat the AIO admin
#   password as host-level access for everything under /mnt.
#
# NEXTCLOUD_ENABLE_NVIDIA_GPU=true
#   Allows AIO to attach the host's NVIDIA GPU to spawned containers that
#   benefit (e.g. Memories transcoding). Requires NVIDIA Container Toolkit
#   on the host.
