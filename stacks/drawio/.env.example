# =============================================================================
# draw.io stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# Base URL draw.io uses to construct export/share links and load static assets.
# Must exactly match the URL you access the app from, including scheme.
# Mismatches break PNG/SVG exports and any embedded diagram links.
DRAWIO_BASE_URL=https://drawio.example.com

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Host port published for the web UI (container listens on 8080, hardcoded in
# the jgraph/drawio image). Published on all interfaces so the app is reachable
# on your LAN out of the box. Prefer it behind a reverse proxy / loopback only?
# Prefix the mapping in compose.yaml with 127.0.0.1:.
DRAWIO_PORT=8080
