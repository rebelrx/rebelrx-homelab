# =============================================================================
# BentoPDF stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# Container timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Etc/UTC

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Host port published for the web UI (host side of ${BENTOPDF_PORT}:8080; the
# container listens on 8080). Published on all interfaces so the app is reachable
# on your LAN out of the box. Prefer it behind a reverse proxy / loopback only?
# Prefix the mapping in compose.yaml with 127.0.0.1:.
# NOTE: 3000 is a common port (used by other apps like documenso, Grafana) —
# change it if it clashes with another service on the host.
BENTOPDF_PORT=3000
