# =============================================================================
# Guest stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
#
# This stack hosts per-app Tailscale sidecars that expose specific homelab
# services to tailnet guests with isolated identities. One sidecar per
# guest-exposed app — currently RomM only.
#
# When adding a new sidecar (see README "Adding a new guest sidecar"), follow
# the same variable pattern: TS_AUTHKEY_<APP>, TAILSCALE_<APP>_STATE,
# SERVE_CONFIG_<APP>.
# =============================================================================

# -----------------------------------------------------------------------------
# tailscale-romm — RomM guest sidecar
# -----------------------------------------------------------------------------

# Tailscale auth key. Single-use after the node is registered — the container
# only consumes it when the state dir doesn't yet contain an identity.
#
# Generate at: https://login.tailscale.com/admin/settings/keys
#   - Use a single-use, non-ephemeral key for long-lived guest sidecars.
#   - Revoke the key in the admin console after registration completes; the
#     state dir keeps the identity working independently of the key.
#
# You can either leave this populated (idempotent: only used on fresh state
# dirs) or clear it after first registration for tighter ops.
TS_AUTHKEY=

# Tailscale node state — machine key, identity, and preferences. Persistent
# across restarts; identity-bearing. Include in backups — restoring this on
# a fresh host avoids re-registration and keeps the same machine key so
# existing guest shares continue to work.
TAILSCALE_ROMM_STATE=/path/to/tailscale/romm

# `serve.json` config for this sidecar — declares what HTTP service the node
# proxies. MUST exist before first start. See README "serve.json format" for
# the schema.
SERVE_CONFIG=/path/to/tailscale/config/serve-romm.json
