# =============================================================================
# Nginx Proxy Manager stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
#
# NPM is the homelab's keystone — every other *.example URL depends on this
# container being healthy. When it goes down, nothing is reachable by
# hostname. Take more care than usual with reboots and upgrades.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# Container timezone — affects cert renewal log timestamps and access log
# rotation. See https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Etc/UTC

# -----------------------------------------------------------------------------
# Admin UI port
# -----------------------------------------------------------------------------

# Host port for the NPM admin UI. Loopback-bound in compose
# (`127.0.0.1:${NPM_ADMIN_PORT}:81`) so it's only reachable from the host
# itself or via SSH tunnel — never from the LAN or tailnet directly. Day-to-day
# admin access goes through NPM proxying itself at npm.<your-domain>.
#
# This is the fallback when NPM itself is broken — see README "Bootstrap loop".
NPM_ADMIN_PORT=81

# -----------------------------------------------------------------------------
# Volume paths
# -----------------------------------------------------------------------------

# NPM SQLite DB (proxy hosts, redirection rules, users), Nginx config
# snippets, custom locations. Losing this means manually rebuilding every
# NPM entry from scratch — include in every backup schedule.
NPM_DATA=/path/to/npm/data

# Let's Encrypt account keys, issued certificates, renewal history.
# Losing certs forces re-issuance (rate-limited by Let's Encrypt); losing
# account keys forces a fresh ACME account.
NPM_LETSENCRYPT=/path/to/npm/letsencrypt

# -----------------------------------------------------------------------------
# Reference only — not consumed by compose
# -----------------------------------------------------------------------------

# Container HTTP / HTTPS listen ports. Hardcoded as `80:80` and `443:443` in
# compose. Documented for visibility; both must be free on all host
# interfaces (no other web server running).
#NPM_HTTP_PORT=80
#NPM_HTTPS_PORT=443

# DISABLE_IPV6=true is set directly in compose.yml's environment block. Flip
# to false if you ever enable IPv6 on the host.
