# =============================================================================
# MkDocs stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
#
# Two-container docs stack: `mkdocs` runs the Material for MkDocs live-preview
# dev server (auto-rebuilds on edit); `mkdocs-web` (nginx) serves the built
# static site. No secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------
# Both published on all interfaces so they're reachable on your LAN out of the
# box. Prefer them behind a reverse proxy / loopback only? Prefix each mapping
# in compose.yaml with 127.0.0.1:.

# MkDocs live-preview dev server (container listens on 8000).
MKDOCS_PORT=8005

# Nginx serving the built static site (container listens on 80).
MKDOCS_WEB_PORT=8006

# -----------------------------------------------------------------------------
# Volume paths
# -----------------------------------------------------------------------------

# MkDocs PROJECT directory — mounted at /docs in the container. Contains
# mkdocs.yml, the docs/ source tree, and the built site/ output. This is the
# project root, not just the docs subfolder.
MKDOCS_PROJECT_PATH=/path/to/mkdocs/project

# Built static site directory (the `site/` output MkDocs generates), served
# read-only by nginx. Typically ${MKDOCS_PROJECT_PATH}/site.
MKDOCS_SITE=/path/to/mkdocs/project/site
