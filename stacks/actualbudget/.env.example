# =============================================================================
# Actual Budget stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# Volume paths
# -----------------------------------------------------------------------------

# Host path for /data inside the container. Contains budget files, the SQLite
# database, and server config. Include this path in Kopia / Borgmatic snapshots.
ACTUAL_DATA_PATH=/path/to/actual/data

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Host port published for the web UI (host side of ${ACTUAL_PORT}:5006). Published
# on all interfaces by default, so the web UI is reachable on your LAN out of the box.
# Prefer to keep it behind a reverse proxy / loopback only? Prefix the mapping in
# compose.yaml with 127.0.0.1: -> "127.0.0.1:${ACTUAL_PORT}:5006".
ACTUAL_PORT=5006
