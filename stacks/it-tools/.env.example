# =============================================================================
# IT-Tools stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
#
# IT-Tools is a stateless, client-side static app — no database, no secrets,
# no persistent runtime data. This file is intentionally minimal; the stack is
# defined almost entirely in compose.yaml.
# =============================================================================

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Host port published for the web UI (the sharevb image's unprivileged nginx
# listens on 8080 internally — NOT 80 like the original corentinth image).
# Published on all interfaces so it's reachable on your LAN out of the box.
# Prefer it behind a reverse proxy / loopback only? Prefix the mapping in
# compose.yaml with 127.0.0.1:.
#
# NOTE: some tools (PGP, WebCrypto, PWA install) require a SECURE CONTEXT and
# silently fail over plain http://. Reaching the app directly at
# http://<host-ip>:8080 works for most tools but breaks those — use an https://
# reverse proxy for full functionality.
IT_TOOLS_HTTP_PORT=8080

# -----------------------------------------------------------------------------
# General — optional
# -----------------------------------------------------------------------------

# Container timezone — cosmetic only (nginx access-log timestamps); the app is
# client-side and uses the browser's clock. NOT consumed by the stock minimal
# compose — add `TZ=${TIMEZONE}` to a compose `environment:` block to apply it.
TIMEZONE=Etc/UTC

# -----------------------------------------------------------------------------
# Volume paths — optional
# -----------------------------------------------------------------------------
# IT-Tools needs NO volumes to run. This path is only used if you enable the
# optional customization mounts in compose.yaml (commented out by default):
#
#   ${IT_TOOLS_CONFIG}/tools-filter.json  -> filter which tools/categories show
#   ${IT_TOOLS_CONFIG}/home.custom.md     -> custom markdown on the home page
#
# Leave this as-is and keep the volume block commented for stock behavior.
IT_TOOLS_CONFIG=/path/to/it-tools/config

# -----------------------------------------------------------------------------
# Reference only — not consumed by compose
# -----------------------------------------------------------------------------

# Image tag is pinned directly in compose.yaml so WUD (notify-only) can watch
# for newer tags without auto-pulling. Not pulled from .env.
# Current pin: v2026.1.4
#IT_TOOLS_IMAGE_TAG=v2026.1.4
