# =============================================================================
# What's Up Docker (WUD) stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# Container timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Used for scan-time log entries and notification timestamps.
TIMEZONE=Etc/UTC

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Host port published for the web UI (the container listens on 3000). Published
# on all interfaces so it's reachable on your LAN out of the box. Prefer it
# behind a reverse proxy / loopback only? Prefix the mapping in compose.yaml
# with 127.0.0.1:.
# NOTE: 3000 is a common port (documenso, Grafana, etc.) — change if it clashes.
WUD_PORT=3000

# -----------------------------------------------------------------------------
# Volume paths
# -----------------------------------------------------------------------------

# WUD persistent state — scan history, notification dedup state, dashboard data.
# Include in Kopia / Borgmatic snapshots (or accept that a wiped store re-emits
# one notification per already-pending update and resets the dashboard view).
WUD_STORE=/path/to/wud/store

# -----------------------------------------------------------------------------
# SMTP notification trigger
# -----------------------------------------------------------------------------
# WUD sends an email whenever a watched container has a new image available.
# Any authenticated SMTP relay works — Gmail with app password, Fastmail,
# Mailgun, a local relay, etc.
#
# WUD_TRIGGER_SMTP_EMAIL_TLS_ENABLED is hardcoded false in compose.yaml,
# suitable for STARTTLS on port 587. If using TLS-from-connect (port 465),
# edit compose to set it true.

# SMTP server hostname and port.
WUD_TRIGGER_SMTP_EMAIL_HOST=smtp.example.com
WUD_TRIGGER_SMTP_EMAIL_PORT=587

# SMTP auth credentials.
WUD_TRIGGER_SMTP_EMAIL_USER=
WUD_TRIGGER_SMTP_EMAIL_PASS=

# Outbound From address. Some relays reject mail where From doesn't match
# the authenticated user — set both consistently if you hit auth errors.
WUD_TRIGGER_SMTP_EMAIL_FROM=wud@example.com

# Recipient address. Multiple recipients separated by `;` (not `,`).
WUD_TRIGGER_SMTP_EMAIL_TO=you@example.com

# -----------------------------------------------------------------------------
# Reference only — not consumed by compose
# -----------------------------------------------------------------------------

# WUD_SERVER_PORT is referenced only by the healthcheck in compose.yaml, with a
# :-3000 default, so it works unset. Set it if you change WUD's internal port.
#WUD_SERVER_PORT=3000

# WUD_TRIGGER_SMTP_EMAIL_TLS_ENABLED is set directly in compose.yaml's
# environment block, not pulled from .env. Edit compose to change it.
# Current value: false (correct for STARTTLS on port 587).
