# =============================================================================
# Homepage stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# Container timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Etc/UTC

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Host port published for the web UI (container listens on 3000). Published on
# all interfaces so the UI is reachable on your LAN out of the box. Prefer it
# behind a reverse proxy / loopback only? Prefix the mapping in compose.yaml
# with 127.0.0.1:.
# NOTE: 3000 is a common port (documenso, Grafana, etc.) — change if it clashes.
# NOTE: if you reach Homepage directly by IP (http://<host-ip>:3000), add that
# IP to HOMEPAGE_ALLOWED_HOSTS below or Homepage returns a blank page / 403.
HOMEPAGE_PORT=3000

# -----------------------------------------------------------------------------
# Required — host allowlist
# -----------------------------------------------------------------------------

# Comma-separated list of `Host:` headers Homepage will accept. Any request
# with a Host header not in this list returns a blank page or 403.
# Added upstream in 2024 to prevent open-proxy / DNS-rebinding abuse.
#
# Must match exactly what NPM (or any other client) sends in the Host header.
# Update both sides together if you add new hostnames. Include your host's LAN
# IP here if you access Homepage directly by IP.
#
# Example: homepage.example.com,home.example.com,192.168.1.10
HOMEPAGE_ALLOWED_HOSTS=homepage.example.com,localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Volume paths
# -----------------------------------------------------------------------------

# All Homepage config — YAML files (services, widgets, bookmarks, settings,
# docker integration) plus optional custom.css / custom.js. The container
# writes default templates here on first start if the directory is empty.
# Include in backups; consider version-controlling alongside the stack.
HOMEPAGE_CONFIG=/path/to/homepage/config

# Custom icons surfaced in service cards via `homepage.icon=<filename>`.
# Drop PNG/SVG files here. Homepage already ships with the Dashboard Icons
# set built in — this mount is only needed for icons outside that set.
HOMEPAGE_ICONS=/path/to/homepage/icons

# -----------------------------------------------------------------------------
# Widget secrets
# -----------------------------------------------------------------------------
# Any variable prefixed with HOMEPAGE_VAR_ is exposed to Homepage and can be
# referenced inside services.yaml / widgets.yaml using the {{HOMEPAGE_VAR_*}}
# substitution syntax — for example:
#
#   widget:
#     type: proxmox
#     url: https://proxmox.example.com
#     username: {{HOMEPAGE_VAR_PROXMOX_USERNAME}}
#     password: {{HOMEPAGE_VAR_PROXMOX_PASSWORD}}
#     node: {{HOMEPAGE_VAR_PROXMOX_NODE}}
#
# This keeps secrets out of the version-controlled YAML and inside .env where
# they belong. Leave any unused variables blank — they're harmless if defined
# but unreferenced.

# ProxMox VE
HOMEPAGE_VAR_PROXMOX_USERNAME=
HOMEPAGE_VAR_PROXMOX_PASSWORD=
HOMEPAGE_VAR_PROXMOX_NODE=

# Portainer
HOMEPAGE_VAR_PORTAINER_KEY=

# AdGuard Home
HOMEPAGE_VAR_ADGUARD_USERNAME=
HOMEPAGE_VAR_ADGUARD_PASSWORD=

# Pi-hole
HOMEPAGE_VAR_PIHOLE_KEY=

# Kopia
HOMEPAGE_VAR_KOPIA_USERNAME=
HOMEPAGE_VAR_KOPIA_PASSWORD=

# Uptime Kuma
HOMEPAGE_VAR_UPTIME_SLUG=
HOMEPAGE_VAR_UPTIME_KEY=

# Jellyfin
HOMEPAGE_VAR_JELLYFIN_KEY=

# Immich
HOMEPAGE_VAR_IMMICH_KEY=

# Navidrome
HOMEPAGE_VAR_NAVIDROME_USER=
HOMEPAGE_VAR_NAVIDROME_TOKEN=
HOMEPAGE_VAR_NAVIDROME_SALT=

# Calibre-Web
HOMEPAGE_VAR_CALIBREWEB_USERNAME=
HOMEPAGE_VAR_CALIBREWEB_PASSWORD=

# Kavita
HOMEPAGE_VAR_KAVITA_KEY=

# Audiobookshelf
HOMEPAGE_VAR_AUDIOBOOKSHELF_KEY=

# CoinMarketCap
HOMEPAGE_VAR_COINMARKETCAP_KEY=
