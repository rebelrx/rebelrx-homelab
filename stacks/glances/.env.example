# =============================================================================
# Glances (system + GPU monitoring) stack — environment variables
# Copy to .env, adjust, then lock it down:   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# Host timezone — passed to the container so timestamps (uptime, history)
# render in local time rather than UTC.
TIMEZONE=America/New_York

# -----------------------------------------------------------------------------
# Reference only (not variables — documented so the moving parts are in one place)
# -----------------------------------------------------------------------------
# All other settings are hardcoded in compose.yaml, not driven by .env:
#   GLANCES_OPT=-w -C /etc/glances/glances.conf   (web mode + custom config)
#   NVIDIA_VISIBLE_DEVICES / NVIDIA_DRIVER_CAPABILITIES=all   (GPU)
#
# The API listens on 61208 (host network mode). Access is gated by UFW —
# replace the subnet with your own LAN range:
#   sudo ufw allow from 192.168.1.0/24 to any port 61208 proto tcp comment 'Glances API (LAN)'
#
# Verify after deploy (replace <host-ip> with the host's LAN IP):
#   curl -s http://<host-ip>:61208/api/4/status
