# =============================================================================
# SnapOtter stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# Service config
# -----------------------------------------------------------------------------

# Bootstrap admin username. SnapOtter seeds this account (DEFAULT_USERNAME) on
# first run against an empty database. It is only read during that initial
# seed — changing it later will NOT rename an existing account, it would create
# a second one. Leave as-is unless you have a reason to change it.
SNAPOTTER_ADMIN_USER=admin

# -----------------------------------------------------------------------------
# Volume paths
# -----------------------------------------------------------------------------

# App data — SnapOtter's /data: processed files and working state. Back this up.
SNAPOTTER_DATA_PATH=/path/to/snapotter/data

# Postgres PGDATA. Database of record — user accounts, job history, all
# application state. This is the thing to back up (Borg/Kopia, per convention);
# losing it loses everything the app knows.
SNAPOTTER_DB_PATH=/path/to/snapotter/pgdata

# Redis /data. The broker runs --appendonly yes + noeviction, so this holds
# AOF-persisted job state, not a throwaway cache. Losing it drops in-flight /
# queued jobs but not committed application data.
SNAPOTTER_CACHE_PATH=/path/to/snapotter/redis

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------

# Postgres password. Consumed as POSTGRES_PASSWORD (db) and interpolated into
# DATABASE_URL (app) from this single var, so the two always agree. Because it
# lands in a connection URL it MUST be URL-safe — generate with hex, not base64
# (base64 can emit / + = @ which break URL parsing):
#   openssl rand -hex 32
SNAPOTTER_DB_PASSWORD=

# Bootstrap admin password (DEFAULT_PASSWORD). Entered at the login form, not
# embedded in a URL, so base64 is fine here. Rotate via the app after first
# login if it supports it.
#   openssl rand -base64 24
SNAPOTTER_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Reference only — not consumed by compose
# -----------------------------------------------------------------------------

# DB user / name — hardcoded in compose.yaml as snapotter / snapotter.
#SNAPOTTER_DB_USER=snapotter
#SNAPOTTER_DB_NAME=snapotter

# App connection strings — set in compose.yaml:
#   DATABASE_URL = postgres://snapotter:${SNAPOTTER_DB_PASSWORD}@postgres:5432/snapotter
#   REDIS_URL    = redis://redis:6379            (Redis is unauthenticated)
# Both backends are reachable only on the internal snapotter network.

# SnapOtter's internal listen port — targeted directly by the NPM upstream over
# proxy_net (no host port is published by default). Confirm the value from the
# docs. If you want to ALSO publish it on the host (per this repo's default),
# set this and add `ports: - ${SNAPOTTER_PORT}:<that-port>` to the snapotter
# service in compose.yaml.
#SNAPOTTER_PORT=
