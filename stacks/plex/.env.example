# =============================================================================
# Plex stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# UID / GID for file ownership inside the container (linuxserver convention).
# Match the user that owns the bind-mount targets on the host.
PUID=1000
PGID=1000

# Container timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Etc/UTC

# -----------------------------------------------------------------------------
# First-run claim token
# -----------------------------------------------------------------------------

# One-time token from https://www.plex.tv/claim — binds this Plex server to
# your Plex account on first launch. Valid for ~4 MINUTES from generation,
# so fetch it just before `docker compose up -d`.
#
# After first launch the server is permanently bound to your account; this
# value becomes meaningless and can be cleared from .env.
#
# If you're restoring on a new host or need to re-claim, generate a fresh
# token first — expired tokens are ignored silently.
PLEX_CLAIM=

# -----------------------------------------------------------------------------
# Config paths (local NVMe)
# -----------------------------------------------------------------------------

# Plex Media Server config, library DB, metadata cache, plugins. Essential
# for restore — include in Kopia / Borgmatic snapshots. The metadata cache
# under <config>/Library/Application Support/Plex Media Server/Metadata can
# grow to tens of GB; rebuildable but slow.
PLEX_CONFIG=/path/to/plex/library

# Transcode scratch space. MUST be local NVMe — Plex writes intermediate
# transcode segments at high frequency, NFS latency causes playback stutter.
# Volatile; exclude from backups.
PLEX_TRANSCODE=/path/to/plex/transcode

# -----------------------------------------------------------------------------
# Media library paths (NFS share on NAS)
# -----------------------------------------------------------------------------
# Ensure the NAS share is mounted before bringing up the stack. To add another
# library (audiobooks, comics, etc.), add a new explicit mount in compose.yml
# and a corresponding variable here — don't reach into a catch-all root.

PLEX_MOVIES=/path/to/nas-media/movies
PLEX_TV=/path/to/nas-media/tv
PLEX_MUSIC=/path/to/nas-media/music

# -----------------------------------------------------------------------------
# Reference only — not consumed by compose
# -----------------------------------------------------------------------------

# Plex web UI / API port. Listens on every host interface due to
# network_mode: host. UFW gates reachability — only allowed in on tailscale0:
#   sudo ufw allow in on tailscale0 to any port 32400 proto tcp \
#     comment 'Plex via Tailscale'
#PLEX_PORT=32400

# VERSION (linuxserver image tag), NVIDIA_VISIBLE_DEVICES, and
# NVIDIA_DRIVER_CAPABILITIES are set directly in compose.yml's environment
# block — not pulled from .env. Edit compose to change them. Current values:
# VERSION=docker (stable), NVIDIA_*=all.
