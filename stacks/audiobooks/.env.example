# =============================================================================
# Audiobookshelf stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# Container timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Etc/UTC

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Host port published for the web UI (host side of ${AUDIOBOOKSHELF_PORT}:80).
# 13378 matches upstream's docker-compose example. Published on all interfaces so
# the UI is reachable on your LAN out of the box. Prefer it behind a reverse proxy
# / loopback only? Prefix the mapping in compose.yaml with 127.0.0.1:.
AUDIOBOOKSHELF_PORT=13378

# -----------------------------------------------------------------------------
# Config paths (local NVMe)
# -----------------------------------------------------------------------------

# Application config, SQLite DB, and user accounts.
# Essential for restore — include in Kopia / Borgmatic snapshots.
AUDIOBOOKSHELF_CONFIG=/path/to/audiobookshelf/config

# Cover art, generated metadata, and cache.
# Optional in backups (rebuildable from a fresh scan, but slow on a large library).
AUDIOBOOKSHELF_METADATA=/path/to/audiobookshelf/metadata

# -----------------------------------------------------------------------------
# Library paths (NFS share on NAS)
# -----------------------------------------------------------------------------
# Ensure the NAS share is mounted before bringing up the stack.

AUDIOBOOKS_PATH=/path/to/nas-media/audiobooks
PODCASTS_PATH=/path/to/nas-media/podcasts
