# =============================================================================
# Homebox stack — environment variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env to git.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets — DO NOT CHANGE POST-INIT
# -----------------------------------------------------------------------------

# Per-instance pepper mixed into API-key hashing.
# Changing this value AFTER first boot invalidates every existing API key
# issued by this instance — treat it like an encryption key.
# Generate with:
#   openssl rand -hex 32
HBOX_AUTH_API_KEY_PEPPER=

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Host port published for the web UI (container listens on 7745). Published on
# all interfaces so the UI is reachable on your LAN out of the box. Prefer it
# behind a reverse proxy / loopback only? Prefix the mapping in compose.yaml
# with 127.0.0.1:.
HOMEBOX_PORT=7745

# -----------------------------------------------------------------------------
# Volume paths
# -----------------------------------------------------------------------------

# App data — SQLite DB, uploaded images, attachments. Everything Homebox
# persists lives here; a snapshot of this dir is a complete backup.
HOMEBOX_DATA=/path/to/homebox/homebox-data

# -----------------------------------------------------------------------------
# Reference only — not consumed by compose
# -----------------------------------------------------------------------------

# HBOX_* settings (log level, format, upload size limit, analytics opt-out)
# are set directly in compose.yaml's environment block, not pulled from .env.
# Edit compose.yaml to change them.
